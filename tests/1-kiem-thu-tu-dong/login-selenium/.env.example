# URL he thong
BASE_URL=http://localhost:5000
LOGIN_PATH=/Account/Login

# Danh sach trinh duyet can chay (phan cach boi dau phay): coccoc,safari,chrome
BROWSERS=coccoc,safari,chrome
ASK_BROWSER_ON_START=true

# Tai khoan learner de test dang nhap thanh cong
VALID_EMAIL=alex@example.com
VALID_PASSWORD=Learner@123
EXPECTED_DASHBOARD_PATH=/Learner/Dashboard

# Tai khoan learner phu (test pass bo sung)
SECONDARY_LEARNER_EMAIL=maria@example.com
SECONDARY_LEARNER_PASSWORD=Learner@123
SECONDARY_LEARNER_DASHBOARD_PATH=/Learner/Dashboard

# Tai khoan admin
ADMIN_EMAIL=admin@edulms.com
ADMIN_PASSWORD=Admin@123
ADMIN_DASHBOARD_PATH=/Admin/Dashboard

# Tai khoan instructor
INSTRUCTOR_EMAIL=lehoang@edulms.com
INSTRUCTOR_PASSWORD=Instructor@123
INSTRUCTOR_DASHBOARD_PATH=/Instructor/Dashboard

# COC COC (neu bo trong, Selenium dung browser Chrome mac dinh)
# MacOS thuong la: /Applications/CocCoc.app/Contents/MacOS/CocCoc
COCCOC_BINARY_PATH=

# Chrome binary tuy chon (chi dung khi BROWSERS co chrome)
CHROME_BINARY_PATH=

# Neu Selenium khong tu tim duoc chromedriver, truyen duong dan tai day
CHROMEDRIVER_PATH=

# Cai dat chay
HEADLESS=false
TIMEOUT_MS=10000
