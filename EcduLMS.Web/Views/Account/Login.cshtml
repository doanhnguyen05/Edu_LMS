@model EduLMS.Web.ViewModels.Account.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - EduLMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            padding: 2.5rem;
            width: 100%;
            max-width: 440px;
        }
        .auth-logo {
            color: #2563EB;
            font-weight: 700;
            font-size: 1.5rem;
        }
        .auth-logo i {
            font-size: 1.75rem;
        }
        .input-icon-wrapper {
            position: relative;
        }
        .input-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }
        .input-icon-wrapper input {
            padding-left: 42px;
        }
        .btn-primary-custom {
            background-color: #2563EB;
            border-color: #2563EB;
            font-weight: 600;
        }
        .btn-primary-custom:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }
        .tip-box {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
            color: #1e40af;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="auth-logo mb-2">
                <i class="bi bi-mortarboard-fill me-1"></i> EduLMS
            </div>
            <h5 class="fw-bold mb-1">Đăng nhập vào hệ thống</h5>
            <p class="text-muted mb-0">
                Chưa có tài khoản?
                <a href="@Url.Action("Register", "Account")" class="text-decoration-none" style="color: #2563EB;">Đăng ký ngay</a>
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 small">@TempData["SuccessMessage"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold"></label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Password" class="form-label small fw-semibold"></label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end mb-3">
                <a href="@Url.Action("ForgotPassword", "Account")" class="text-decoration-none small" style="color: #2563EB;">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary-custom btn-primary text-white w-100 py-2 mb-3">
                Đăng nhập <i class="bi bi-arrow-right"></i>
            </button>

            <div class="tip-box">
                <i class="bi bi-lightbulb me-1"></i>
                <strong>Mẹo:</strong> Đăng nhập với email có chứa 'admin' hoặc 'instructor' để xem các dashboard khác nhau.
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
