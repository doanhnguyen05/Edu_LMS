@{
    ViewData["Title"] = "Trung tâm Hỗ trợ";
}

<!-- Header -->
<section class="help-header">
    <div class="container">
        <div class="mb-3">
            <i class="bi bi-life-preserver" style="font-size: 3rem; color: #2563EB;"></i>
        </div>
        <h1>Trung tâm Hỗ trợ</h1>
        <p class="text-muted mt-3 mb-0">Chúng tôi luôn sẵn sàng hỗ trợ bạn trong quá trình học tập</p>
    </div>
</section>

<!-- Usage Guide -->
<section class="section-white">
    <div class="container">
        <h2 class="section-title">Hướng dẫn sử dụng</h2>
        <p class="section-subtitle">Các hướng dẫn chi tiết giúp bạn sử dụng hệ thống hiệu quả</p>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-journal-plus"></i></div>
                    <h6>Cách đăng ký khóa học chi tiết</h6>
                    <p>Hướng dẫn từng bước đăng ký và tham gia các khóa học trên hệ thống EduLMS.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-upload"></i></div>
                    <h6>Hướng dẫn nộp bài tập qua hệ thống</h6>
                    <p>Cách nộp bài tập trực tuyến, kiểm tra trạng thái nộp bài và xem phản hồi từ giảng viên.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-bar-chart-line"></i></div>
                    <h6>Cách xem điểm và đánh giá</h6>
                    <p>Hướng dẫn xem điểm số, kết quả đánh giá và tiến độ học tập của bạn.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-camera-video"></i></div>
                    <h6>Tham gia phòng học ảo</h6>
                    <p>Cách tham gia các buổi học trực tuyến, sử dụng phòng học ảo và tương tác với giảng viên.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-chat-dots"></i></div>
                    <h6>Cách liên hệ với giảng viên</h6>
                    <p>Hướng dẫn gửi tin nhắn, đặt câu hỏi và liên hệ trực tiếp với giảng viên.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="guide-card">
                    <div class="guide-icon"><i class="bi bi-bell"></i></div>
                    <h6>Quản lý thông báo và email</h6>
                    <p>Tùy chỉnh cài đặt thông báo, email và các kênh nhận thông tin từ hệ thống.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="section-light">
    <div class="container">
        <h2 class="section-title">Câu hỏi thường gặp</h2>
        <p class="section-subtitle">Những câu hỏi phổ biến nhất từ học viên</p>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion faq-accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading1">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1">
                                <i class="bi bi-question-circle me-2" style="color: #2563EB;"></i>
                                Làm thế nào để đăng ký tài khoản trên EduLMS?
                            </button>
                        </h2>
                        <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Bạn có thể đăng ký tài khoản bằng cách nhấn vào nút "Đăng nhập hệ thống" trên thanh menu, sau đó chọn "Đăng ký tài khoản mới". Điền đầy đủ thông tin cá nhân, xác nhận email và bạn đã sẵn sàng sử dụng hệ thống.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
                                <i class="bi bi-question-circle me-2" style="color: #2563EB;"></i>
                                Tôi có thể học trên thiết bị di động không?
                            </button>
                        </h2>
                        <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Có, EduLMS được thiết kế tương thích hoàn toàn với các thiết bị di động. Bạn có thể truy cập hệ thống qua trình duyệt trên điện thoại hoặc máy tính bảng để học tập mọi lúc, mọi nơi.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
                                <i class="bi bi-question-circle me-2" style="color: #2563EB;"></i>
                                Làm sao để liên hệ với giảng viên khi có thắc mắc?
                            </button>
                        </h2>
                        <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Bạn có thể liên hệ với giảng viên thông qua hệ thống tin nhắn trong khóa học, hoặc sử dụng tính năng bình luận trong từng bài học. Giảng viên sẽ phản hồi trong thời gian sớm nhất.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading4">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4">
                                <i class="bi bi-question-circle me-2" style="color: #2563EB;"></i>
                                Chính sách hoàn tiền như thế nào?
                            </button>
                        </h2>
                        <div id="faqCollapse4" class="accordion-collapse collapse" aria-labelledby="faqHeading4" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                EduLMS hỗ trợ hoàn tiền trong vòng 7 ngày kể từ ngày đăng ký khóa học nếu bạn chưa hoàn thành quá 20% nội dung khóa học. Vui lòng liên hệ bộ phận hỗ trợ để được xử lý yêu cầu hoàn tiền.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
