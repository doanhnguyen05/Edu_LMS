@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: #1E293B;
        line-height: 1.2;
    }
    .stat-label {
        font-size: 13px;
        color: #94A3B8;
        margin-top: 2px;
    }
    .stat-meta {
        font-size: 12px;
        color: #64748B;
        margin-top: 4px;
    }
    .card-panel {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 24px;
    }
    .card-panel-title {
        font-size: 16px;
        font-weight: 600;
        color: #1E293B;
        margin-bottom: 20px;
    }
    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #F1F5F9;
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .activity-desc {
        font-size: 14px;
        color: #334155;
        line-height: 1.4;
    }
    .activity-time {
        font-size: 12px;
        color: #94A3B8;
        margin-top: 2px;
    }
    .view-all-link {
        display: block;
        text-align: center;
        padding: 14px;
        font-size: 14px;
        color: #2563EB;
        text-decoration: none;
        border-top: 1px solid #E2E8F0;
        margin-top: 8px;
    }
    .view-all-link:hover { background: #F8FAFC; }
    .activity-empty {
        text-align: center;
        padding: 24px 0;
        color: #64748B;
    }
</style>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon" style="background: #EFF6FF; color: #2563EB;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="stat-value" id="totalUsersValue">@(Model.TotalUsers >= 1000 ? $"{Model.TotalUsers / 1000.0:0.#}k" : Model.TotalUsers.ToString())</div>
                <div class="stat-label">Tổng User</div>
                <div class="stat-meta" id="totalUsersMeta">@Model.ActiveUsers đang hoạt động</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon" style="background: #F0FDF4; color: #16A34A;">
                <i class="bi bi-book-fill"></i>
            </div>
            <div>
                <div class="stat-value" id="totalCoursesValue">@Model.TotalCourses</div>
                <div class="stat-label">Khóa học</div>
                <div class="stat-meta" id="totalCoursesMeta">@Model.PublishedCourses đã công bố</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon" style="background: #FDF4FF; color: #A855F7;">
                <i class="bi bi-person-workspace"></i>
            </div>
            <div>
                <div class="stat-value" id="totalInstructorsValue">@Model.TotalInstructors</div>
                <div class="stat-label">Giảng viên</div>
                <div class="stat-meta" id="totalInstructorsMeta">@Model.ActiveInstructors đang hoạt động</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon" style="background: #FFF7ED; color: #EA580C;">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div>
                <div class="stat-value" id="totalStudyHoursValue">@(Model.TotalStudyHours >= 1000 ? $"{Model.TotalStudyHours / 1000.0m:0.#}k" : Model.TotalStudyHours.ToString("0.#"))</div>
                <div class="stat-label">Giờ học công bố</div>
                <div class="stat-meta" id="totalStudyHoursMeta">@Model.TotalSchedules buổi học đã lên lịch</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon" style="background: #ECFDF5; color: #059669;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="stat-value" id="averageProgressRateValue">@Model.AverageProgressRate.ToString("0.#")%</div>
                <div class="stat-label">Tiến độ trung bình</div>
                <div class="stat-meta" id="averageProgressRateMeta">@Model.TrackedEnrollments ghi danh đang theo dõi</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart + Activity Timeline -->
<div class="row g-4">
    <!-- Chart -->
    <div class="col-lg-8">
        <div class="card-panel">
            <div class="card-panel-title">Biểu đồ truy cập hệ thống</div>
            <div style="position: relative; height: 300px;">
                <canvas id="accessChart"></canvas>
            </div>
        </div>
    </div>
    <!-- Activity Timeline -->
    <div class="col-lg-4">
        <div class="card-panel" style="padding-bottom: 0;">
            <div class="card-panel-title">Dòng thời gian hoạt động</div>
            <div id="activityTimelineList">
                @if (Model.RecentActivities.Any())
                {
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="activity-item">
                            <div class="activity-icon" style="background: @(activity.IconColor)1A; color: @activity.IconColor;">
                                <i class="bi @activity.Icon"></i>
                            </div>
                            <div>
                                <div class="activity-desc">@activity.Description</div>
                                <div class="activity-time">@activity.Time</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="activity-empty">
                        <i class="bi bi-inbox" style="font-size: 32px;"></i>
                        <p class="mt-2 mb-0">Chưa có hoạt động nào</p>
                    </div>
                }
            </div>
            <a href="#" class="view-all-link">
                <i class="bi bi-arrow-right"></i> Xem tất cả log hệ thống
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const dashboardRefreshUrl = '@Url.Action("LiveData", "Dashboard", new { area = "Admin" })';
    const ctx = document.getElementById('accessChart').getContext('2d');
    const accessChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Json.Serialize(Model.AccessChartLabels),
            datasets: [{
                label: 'Hoạt động hệ thống',
                data: @Json.Serialize(Model.AccessChartData),
                borderColor: '#2563EB',
                backgroundColor: 'rgba(37, 99, 235, 0.08)',
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#2563EB',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#F1F5F9' },
                    ticks: { color: '#94A3B8', font: { size: 12 } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#94A3B8', font: { size: 12 } }
                }
            }
        }
    });

    function formatCompactNumber(value) {
        if (value >= 1000) {
            return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`;
        }

        return `${value}`;
    }

    function formatStudyHours(value) {
        if (value >= 1000) {
            return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`;
        }

        return Number(value).toFixed(1).replace(/\.0$/, '');
    }

    function formatPercent(value) {
        return `${Number(value).toFixed(1).replace(/\.0$/, '')}%`;
    }

    function setText(id, text) {
        const element = document.getElementById(id);
        if (element) {
            element.textContent = text;
        }
    }

    function createEmptyActivityState() {
        const wrapper = document.createElement('div');
        wrapper.className = 'activity-empty';
        wrapper.innerHTML = `
            <i class="bi bi-inbox" style="font-size: 32px;"></i>
            <p class="mt-2 mb-0">Chưa có hoạt động nào</p>
        `;
        return wrapper;
    }

    function createActivityItem(activity) {
        const item = document.createElement('div');
        item.className = 'activity-item';

        const icon = document.createElement('div');
        icon.className = 'activity-icon';
        icon.style.background = `${activity.iconColor}1A`;
        icon.style.color = activity.iconColor;

        const iconInner = document.createElement('i');
        iconInner.className = `bi ${activity.icon}`;
        icon.appendChild(iconInner);

        const content = document.createElement('div');

        const description = document.createElement('div');
        description.className = 'activity-desc';
        description.textContent = activity.description;

        const time = document.createElement('div');
        time.className = 'activity-time';
        time.textContent = activity.time;

        content.appendChild(description);
        content.appendChild(time);

        item.appendChild(icon);
        item.appendChild(content);

        return item;
    }

    function renderActivities(activities) {
        const container = document.getElementById('activityTimelineList');
        if (!container) {
            return;
        }

        container.innerHTML = '';

        if (!activities || activities.length === 0) {
            container.appendChild(createEmptyActivityState());
            return;
        }

        activities.forEach(activity => {
            container.appendChild(createActivityItem(activity));
        });
    }

    function updateDashboard(data) {
        setText('totalUsersValue', formatCompactNumber(data.totalUsers));
        setText('totalUsersMeta', `${data.activeUsers} đang hoạt động`);
        setText('totalCoursesValue', data.totalCourses);
        setText('totalCoursesMeta', `${data.publishedCourses} đã công bố`);
        setText('totalInstructorsValue', data.totalInstructors);
        setText('totalInstructorsMeta', `${data.activeInstructors} đang hoạt động`);
        setText('totalStudyHoursValue', formatStudyHours(data.totalStudyHours));
        setText('totalStudyHoursMeta', `${data.totalSchedules} buổi học đã lên lịch`);
        setText('averageProgressRateValue', formatPercent(data.averageProgressRate));
        setText('averageProgressRateMeta', `${data.trackedEnrollments} ghi danh đang theo dõi`);

        accessChart.data.labels = data.accessChartLabels;
        accessChart.data.datasets[0].data = data.accessChartData;
        accessChart.update();

        renderActivities(data.recentActivities);
    }

    let isRefreshingDashboard = false;

    async function refreshDashboard() {
        if (isRefreshingDashboard || document.visibilityState === 'hidden') {
            return;
        }

        isRefreshingDashboard = true;

        try {
            const response = await fetch(dashboardRefreshUrl, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                cache: 'no-store'
            });

            if (!response.ok) {
                throw new Error(`Dashboard refresh failed with status ${response.status}`);
            }

            const data = await response.json();
            updateDashboard(data);
        } catch (error) {
            console.error('Unable to refresh admin dashboard.', error);
        } finally {
            isRefreshingDashboard = false;
        }
    }

    const dashboardIntervalId = window.setInterval(refreshDashboard, 10000);

    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
            refreshDashboard();
        }
    });

    window.addEventListener('beforeunload', () => {
        window.clearInterval(dashboardIntervalId);
    });
</script>
}
