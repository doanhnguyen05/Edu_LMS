@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduLMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #F8FAFC; }

        .sidebar {
            width: 240px;
            background: #FFFFFF;
            border-right: 1px solid #E2E8F0;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }
        .sidebar-logo {
            padding: 20px 16px;
            font-size: 20px;
            font-weight: 700;
            color: #2563EB;
        }
        .sidebar-label {
            padding: 8px 16px;
            font-size: 11px;
            font-weight: 600;
            color: #94A3B8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0 8px;
            margin: 0;
            flex: 1;
        }
        .sidebar-menu li { margin-bottom: 2px; }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 14px;
            color: #64748B;
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.2s, color 0.2s;
        }
        .sidebar-menu a:hover {
            background: #F1F5F9;
            color: #334155;
        }
        .sidebar-menu a.active {
            background: #EFF6FF;
            color: #2563EB;
            font-weight: 600;
        }
        .sidebar-menu a i { font-size: 18px; }
        .sidebar-signout {
            padding: 16px;
            border-top: 1px solid #E2E8F0;
        }
        .sidebar-signout a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 14px;
            color: #DC2626;
            text-decoration: none;
            border-radius: 8px;
        }
        .sidebar-signout a:hover { background: #FEF2F2; }

        .topbar {
            margin-left: 240px;
            height: 64px;
            background: #FFFFFF;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .topbar-bell {
            position: relative;
            font-size: 20px;
            color: #64748B;
            cursor: pointer;
        }
        .topbar-bell .badge {
            position: absolute;
            top: -4px;
            right: -6px;
            background: #DC2626;
            color: #fff;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 10px;
        }
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .topbar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #E0E7FF;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4F46E5;
            font-weight: 600;
            font-size: 14px;
        }
        .topbar-name { font-size: 14px; font-weight: 600; color: #1E293B; }
        .topbar-role { font-size: 12px; color: #94A3B8; }
        .btn-admin {
            background: #2563EB;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-admin:hover { background: #1D4ED8; color: #fff; }
        .btn-admin-outline {
            background: #FFFFFF;
            color: #2563EB;
            border: 1px solid #2563EB;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-admin-outline:hover { background: #EFF6FF; color: #2563EB; }

        .main-content {
            margin-left: 240px;
            padding: 30px;
            background: #F8FAFC;
            min-height: calc(100vh - 64px);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <i class="bi bi-mortarboard-fill"></i> EduLMS
        </div>
        <div class="sidebar-label">Main Menu</div>
        <ul class="sidebar-menu">
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="@(currentController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="@(currentController == "Users" ? "active" : "")">
                    <i class="bi bi-people"></i> Users
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Courses" asp-action="Index"
                   class="@(currentController == "Courses" ? "active" : "")">
                    <i class="bi bi-book"></i> Khoá học
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Notifications" asp-action="Index"
                   class="@(currentController == "Notifications" ? "active" : "")">
                    <i class="bi bi-bell"></i> Notifications
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Payouts" asp-action="Index"
                   class="@(currentController == "Payouts" ? "active" : "")">
                    <i class="bi bi-cash-coin"></i> Thanh toán GV
                </a>
            </li>
        </ul>
        <div class="sidebar-signout">
            <a asp-area="" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
        </div>
    </aside>

    <header class="topbar">
        <div class="topbar-right">
            <button type="button" class="btn-admin" data-bs-toggle="modal" data-bs-target="#quickAddUserModal">
                <i class="bi bi-person-plus"></i> Thêm người dùng
            </button>
            <div class="dropdown d-inline-block">
                <a href="javascript:void(0);" class="btn-admin-outline" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-earmark-bar-graph"></i> Tạo báo cáo <i class="bi bi-chevron-down" style="font-size:11px;"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 10px; border: 1px solid #E2E8F0; min-width: 220px;">
                    <li class="px-3 py-2 border-bottom" style="font-weight: 600; color: #1E293B; font-size: 13px;">Xuất báo cáo Excel</li>
                    <li><a class="dropdown-item py-2 px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="ExportUsersReport"><i class="bi bi-people me-2 text-primary"></i>Báo cáo Người dùng</a></li>
                    <li><a class="dropdown-item py-2 px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="ExportCoursesReport"><i class="bi bi-book me-2 text-success"></i>Báo cáo Khóa học</a></li>
                    <li><a class="dropdown-item py-2 px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="ExportGradesReport"><i class="bi bi-clipboard-check me-2 text-warning"></i>Báo cáo Điểm số</a></li>
                    <li><a class="dropdown-item py-2 px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="ExportPaymentsReport"><i class="bi bi-cash-stack me-2 text-danger"></i>Báo cáo Doanh thu</a></li>
                </ul>
            </div>
            @await Component.InvokeAsync("NotificationBell", new { area = "Admin" })
            <div class="topbar-user dropdown">
                <a href="javascript:void(0);" class="d-flex align-items-center gap-2 text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="topbar-avatar">AD</div>
                    <div>
                        <div class="topbar-name">Administrator</div>
                        <div class="topbar-role">Admin</div>
                    </div>
                    <i class="bi bi-chevron-down" style="font-size: 12px; color: #94A3B8;"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 10px; border: 1px solid #E2E8F0;">
                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Quick Add User Modal -->
    <div class="modal fade" id="quickAddUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: #1E293B;">
                        <i class="bi bi-person-plus me-2 text-primary"></i>Thêm người dùng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-area="Admin" asp-controller="Users" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Họ tên <span class="text-danger">*</span></label>
                                <input type="text" name="FullName" class="form-control" placeholder="Nguyễn Văn A" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Email <span class="text-danger">*</span></label>
                                <input type="email" name="Email" class="form-control" placeholder="example@gmail.com" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Số điện thoại</label>
                                <input type="tel" name="Phone" class="form-control" placeholder="0901234567" style="border-radius: 8px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Vai trò <span class="text-danger">*</span></label>
                                <select name="Role" class="form-select" style="border-radius: 8px;">
                                    <option value="Learner">Học viên</option>
                                    <option value="Instructor">Giảng viên</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3 p-3" style="background: #F8FAFC; border-radius: 8px; font-size: 13px; color: #64748B;">
                            <i class="bi bi-info-circle me-1"></i>
                            Mật khẩu mặc định: <strong>Default@123</strong> — người dùng có thể đổi sau khi đăng nhập.
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy</button>
                        <button type="submit" class="btn-admin" style="border-radius: 8px; border: none; padding: 8px 20px;">
                            <i class="bi bi-person-plus me-1"></i> Tạo tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
