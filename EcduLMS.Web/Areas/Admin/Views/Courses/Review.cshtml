@model EduLMS.Web.ViewModels.Admin.CourseReviewViewModel
@using EduLMS.Web.Models.Enums
@{
    ViewData["Title"] = "Xem nội dung khoá học";
    var course = Model.Course;
}

@section Styles {
<style>
    .review-header {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 20px;
    }
    .course-cover {
        width: 120px; height: 80px;
        border-radius: 10px;
        object-fit: cover;
        background: #EFF6FF;
        flex-shrink: 0;
    }
    .course-cover-placeholder {
        width: 120px; height: 80px;
        border-radius: 10px;
        background: #EFF6FF;
        display: flex; align-items: center; justify-content: center;
        color: #93C5FD; font-size: 32px;
        flex-shrink: 0;
    }
    .badge-status {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
    }
    .badge-pending { background: #FEF9C3; color: #A16207; }
    .badge-published { background: #DCFCE7; color: #15803D; }
    .badge-draft { background: #F1F5F9; color: #64748B; }
    .badge-disabled { background: #FEE2E2; color: #DC2626; }

    .info-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
        margin-top: 16px;
    }
    .info-item { }
    .info-label { font-size: 11px; font-weight: 600; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.04em; }
    .info-value { font-size: 14px; font-weight: 500; color: #1E293B; margin-top: 2px; }

    .chapter-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        margin-bottom: 16px;
        overflow: hidden;
    }
    .chapter-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        padding: 14px 20px;
        display: flex; align-items: center; justify-content: space-between;
    }
    .chapter-title {
        font-size: 15px; font-weight: 600; color: #1E293B;
        display: flex; align-items: center; gap: 10px;
    }
    .chapter-badge {
        background: #EFF6FF; color: #2563EB;
        font-size: 11px; font-weight: 700;
        padding: 3px 10px; border-radius: 20px;
    }
    .lesson-row {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 20px;
        border-bottom: 1px solid #F1F5F9;
        font-size: 13px;
    }
    .lesson-row:last-child { border-bottom: none; }
    .lesson-icon { color: #93C5FD; font-size: 16px; flex-shrink: 0; }
    .lesson-title { font-weight: 500; color: #334155; flex: 1; }
    .lesson-duration { color: #94A3B8; font-size: 12px; white-space: nowrap; }
    .lesson-video-link { font-size: 12px; color: #2563EB; text-decoration: none; }
    .lesson-video-link:hover { text-decoration: underline; }
    .assignment-row {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 20px;
        border-bottom: 1px solid #F1F5F9;
        background: #FFFBEB;
        font-size: 13px;
    }
    .assignment-row:last-child { border-bottom: none; }

    .action-bar {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 20px 24px;
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 20px;
    }
    .btn-approve {
        background: #16A34A; color: #fff; border: none;
        border-radius: 8px; padding: 10px 24px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
        transition: background 0.2s;
    }
    .btn-approve:hover { background: #15803D; }
    .btn-reject {
        background: #fff; color: #DC2626; border: 1.5px solid #DC2626;
        border-radius: 8px; padding: 10px 24px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
        transition: all 0.2s;
    }
    .btn-reject:hover { background: #FEE2E2; }
    .btn-back {
        color: #64748B; font-size: 14px; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-back:hover { color: #334155; }
    .empty-content {
        padding: 24px 20px; text-align: center; color: #94A3B8; font-size: 13px;
    }
</style>
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:80px; right:24px; z-index:9999; padding:12px 20px; border-radius:10px; font-size:14px; font-weight:500; box-shadow: 0 4px 20px rgba(0,0,0,0.1); background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0;" id="toastMsg">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

<!-- Breadcrumb -->
<div style="margin-bottom: 20px; font-size: 14px; color: #64748B;">
    <a href="@Url.Action("Index")" style="color: #2563EB; text-decoration: none;">Quản lý khoá học</a>
    <span style="margin: 0 8px;">›</span>
    <span style="color: #1E293B; font-weight: 500;">Xem nội dung</span>
</div>

<!-- Course Info Header -->
<div class="review-header">
    <div style="display:flex; align-items:flex-start; gap:20px;">
        @if (!string.IsNullOrEmpty(course.CoverImageUrl))
        {
            <img src="@course.CoverImageUrl" class="course-cover" alt="@course.Name" />
        }
        else
        {
            <div class="course-cover-placeholder"><i class="bi bi-book"></i></div>
        }
        <div style="flex:1;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap;">
                <h2 style="font-size:20px; font-weight:700; color:#1E293B; margin:0;">@course.Name</h2>
                @if (course.Status == CourseStatus.PendingReview)
                {
                    <span class="badge-status badge-pending"><i class="bi bi-hourglass-split"></i> Chờ duyệt</span>
                }
                else if (course.Status == CourseStatus.Published)
                {
                    <span class="badge-status badge-published"><i class="bi bi-check-circle"></i> Đã công bố</span>
                }
                else if (course.Status == CourseStatus.Draft)
                {
                    <span class="badge-status badge-draft"><i class="bi bi-pencil"></i> Bản nháp</span>
                }
                else
                {
                    <span class="badge-status badge-disabled"><i class="bi bi-eye-slash"></i> Đã ẩn</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(course.Description))
            {
                <p style="font-size:14px; color:#64748B; margin:0 0 12px 0;">@course.Description</p>
            }
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Mã khoá học</div>
                    <div class="info-value"><code style="background:#F1F5F9; padding:2px 6px; border-radius:4px; font-size:13px;">@course.Code</code></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Giảng viên</div>
                    <div class="info-value">@course.Instructor?.FullName</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Danh mục</div>
                    <div class="info-value">@course.Category?.Name</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Loại khoá học</div>
                    <div class="info-value">
                        @if (course.CourseType == CourseType.Free)
                        {
                            <span style="color:#2563EB; font-weight:600;">Miễn phí</span>
                        }
                        else
                        {
                            <span style="color:#16A34A; font-weight:600;">@course.OriginalPrice.ToString("N0") ₫</span>
                        }
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Số chương</div>
                    <div class="info-value">@course.Chapters.Count chương</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Ngày tạo</div>
                    <div class="info-value">@course.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Action Bar (only for PendingReview) -->
@if (course.Status == CourseStatus.PendingReview)
{
    <div class="action-bar">
        <div style="font-size:14px; color:#64748B;">
            <i class="bi bi-info-circle me-2 text-warning"></i>
            Khoá học này đang chờ duyệt. Vui lòng xem xét nội dung bên dưới trước khi quyết định.
        </div>
        <div style="display:flex; gap:10px;">
            <form method="post" asp-action="Reject" asp-route-id="@course.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-reject"
                        onclick="return confirm('Từ chối khoá học này và trả về bản nháp cho giảng viên?')">
                    <i class="bi bi-x-lg"></i> Từ chối
                </button>
            </form>
            <form method="post" asp-action="Approve" asp-route-id="@course.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-approve"
                        onclick="return confirm('Duyệt và công bố khoá học này ngay?')">
                    <i class="bi bi-check-lg"></i> Duyệt & Công bố
                </button>
            </form>
        </div>
    </div>
}

<!-- Course Content -->
<div style="margin-bottom: 8px; display:flex; align-items:center; justify-content:space-between;">
    <h5 style="font-size:16px; font-weight:700; color:#1E293B; margin:0;">
        <i class="bi bi-journal-text me-2 text-primary"></i>Nội dung khoá học
    </h5>
    <span style="font-size:13px; color:#94A3B8;">@course.Chapters.Count chương · @course.Chapters.Sum(ch => ch.Lessons.Count) bài học</span>
</div>

@if (!course.Chapters.Any())
{
    <div class="chapter-card">
        <div class="empty-content">
            <i class="bi bi-journal-x" style="font-size:32px; display:block; margin-bottom:8px;"></i>
            Khoá học chưa có nội dung nào.
        </div>
    </div>
}
else
{
    @foreach (var chapter in course.Chapters.OrderBy(ch => ch.DisplayOrder))
    {
        <div class="chapter-card">
            <div class="chapter-header">
                <div class="chapter-title">
                    <i class="bi bi-folder2-open" style="color:#F59E0B;"></i>
                    Chương @chapter.DisplayOrder: @chapter.Title
                </div>
                <span class="chapter-badge">@chapter.Lessons.Count bài học</span>
            </div>
            @if (!chapter.Lessons.Any() && !chapter.Assignments.Any())
            {
                <div class="empty-content">Chương chưa có bài học nào.</div>
            }
            else
            {
                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.DisplayOrder))
                {
                    <div class="lesson-row">
                        <i class="bi bi-play-circle lesson-icon"></i>
                        <span class="lesson-title">@lesson.Title</span>
                        @if (lesson.DurationMinutes > 0)
                        {
                            <span class="lesson-duration"><i class="bi bi-clock me-1"></i>@lesson.DurationMinutes phút</span>
                        }
                        @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                        {
                            @if (lesson.VideoUrl.StartsWith("/"))
                            {
                                <a href="@lesson.VideoUrl" target="_blank" class="lesson-video-link">
                                    <i class="bi bi-camera-video me-1"></i>Xem video
                                </a>
                            }
                            else
                            {
                                <a href="@lesson.VideoUrl" target="_blank" rel="noopener noreferrer" class="lesson-video-link">
                                    <i class="bi bi-link-45deg me-1"></i>Link video
                                </a>
                            }
                        }
                        else
                        {
                            <span style="font-size:12px; color:#CBD5E1;">Chưa có video</span>
                        }
                    </div>
                }
                @foreach (var assignment in chapter.Assignments.Where(a => a.LessonId == null).OrderBy(a => a.DisplayOrder))
                {
                    <div class="assignment-row">
                        <i class="bi bi-clipboard-check" style="color:#F59E0B; font-size:15px;"></i>
                        <span style="font-weight:500; color:#92400E; flex:1;">@assignment.Title</span>
                        <span style="font-size:12px; color:#A16207;">Bài tập · @assignment.MaxScore điểm</span>
                        @if (assignment.DueDate.HasValue)
                        {
                            <span style="font-size:12px; color:#94A3B8; white-space:nowrap;">
                                Hạn: @assignment.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                            </span>
                        }
                    </div>
                }
            }
        </div>
    }
}

<!-- Back link -->
<div style="margin-top: 16px;">
    <a href="@Url.Action("Index")" class="btn-back">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách khoá học
    </a>
</div>

@section Scripts {
<script>
    setTimeout(() => {
        const t = document.getElementById('toastMsg');
        if (t) t.style.opacity = '0', t.style.transition = 'opacity 0.5s', setTimeout(() => t.remove(), 500);
    }, 3000);
</script>
}
