<!-- Add Assignment Modal -->
<div class="modal fade" id="addAssignmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #1E293B;"><i class="bi bi-file-earmark-plus me-2 text-warning"></i>Thêm bài tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddAssignment" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="chapterId" id="addAssignmentChapterId" />
                <input type="hidden" name="lessonId" id="addAssignmentLessonId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Tên bài tập *</label>
                            <input type="text" name="title" id="addAssignmentTitle" class="form-control" required style="border-radius: 8px;" placeholder="VD: Bài tập tuần 1..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Hạn nộp</label>
                            <input type="datetime-local" name="dueDate" class="form-control" style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Điểm tối đa</label>
                            <input type="number" name="maxScore" class="form-control" value="10" min="1" max="100" step="0.5" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Mô tả bài tập</label>
                            <textarea name="description" id="addAssignmentDescription" rows="10"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 14px;">File đính kèm</label>
                            <input type="file" name="attachment" class="form-control" style="border-radius: 8px;"
                                   accept=".pdf,.doc,.docx,.zip,.rar,.png,.jpg,.jpeg,.txt,.xlsx" />
                            <div class="form-text">Hỗ trợ: PDF, Word, ZIP, RAR, hình ảnh, TXT, Excel. Tối đa 10MB.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy</button>
                    <button type="submit" class="btn btn-warning" style="border-radius: 8px;">
                        <i class="bi bi-plus-lg me-1"></i> Thêm bài tập
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

