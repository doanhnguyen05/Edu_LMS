<!-- Edit Lesson Modal -->
<div class="modal fade" id="editLessonModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #1E293B;">Chỉnh sửa bài học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditLesson" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editLessonId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Tên bài học *</label>
                            <input type="text" name="title" id="editLessonTitle" class="form-control" required style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" style="font-size: 14px;">Thời lượng (phút)</label>
                            <input type="number" name="durationMinutes" id="editLessonDuration" class="form-control" min="0" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 14px;">
                                Video
                                <button type="button" id="editVideoModeBtn" class="btn btn-link btn-sm p-0 ms-2" style="font-size: 12px;" data-mode="file" onclick="toggleEditVideoMode()">
                                    Dùng link URL
                                </button>
                            </label>
                            <div id="editVideoFileBlock">
                                <input type="file" name="videoFile" accept="video/*" class="form-control" style="border-radius: 8px;" />
                            </div>
                            <div id="editVideoUrlBlock" style="display: none;">
                                <input type="url" name="videoUrl" id="editLessonVideoUrl" class="form-control" placeholder="https://youtube.com/..." style="border-radius: 8px;" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="border-radius: 8px;">
                        <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
