@{
    ViewData["Title"] = "Lịch giảng dạy";
    var courses = ViewBag.Courses as IEnumerable<dynamic> ?? new List<dynamic>();
}

@section Styles {
<style>
    /* ── Layout ─────────────────────────── */
    .cal-page { display: grid; grid-template-columns: 1fr 300px; gap: 20px; align-items: start; }
    @@media (max-width: 1100px) { .cal-page { grid-template-columns: 1fr; } }

    /* ── Toolbar ────────────────────────── */
    .cal-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
    }
    .cal-toolbar-left { display: flex; align-items: center; gap: 10px; }
    .cal-title { font-size: 17px; font-weight: 700; color: #1E293B; min-width: 220px; text-align: center; }
    .nav-btn {
        width: 34px; height: 34px; border-radius: 8px;
        border: 1px solid #E2E8F0; background: #fff; color: #64748B;
        cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 13px; transition: all 0.15s;
    }
    .nav-btn:hover { border-color: #2563EB; color: #2563EB; }
    .today-btn {
        background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;
        padding: 7px 14px; font-size: 13px; font-weight: 600; color: #475569; cursor: pointer; transition: all 0.15s;
    }
    .today-btn:hover { border-color: #2563EB; color: #2563EB; }
    .view-switch {
        display: inline-flex; border: 1px solid #E2E8F0; border-radius: 8px;
        overflow: hidden; background: #fff;
    }
    .view-btn {
        border: none; background: #fff; color: #64748B;
        padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer;
    }
    .view-btn + .view-btn { border-left: 1px solid #E2E8F0; }
    .view-btn:hover { background: #F8FAFC; color: #2563EB; }
    .view-btn.active { background: #2563EB; color: #fff; }
    .btn-create {
        display: inline-flex; align-items: center; gap: 7px;
        background: #2563EB; color: #fff; border: none; border-radius: 9px;
        padding: 9px 18px; font-size: 13px; font-weight: 600; cursor: pointer; transition: background 0.15s;
    }
    .btn-create:hover { background: #1D4ED8; }

    /* ── Calendar Grid ──────────────────── */
    .cal-box { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; }
    .cal-grid {
        display: grid;
        grid-template-columns: 80px repeat(7, 1fr);
    }
    .cal-head-empty {
        background: #F8FAFC; border-bottom: 2px solid #E2E8F0; border-right: 1px solid #E2E8F0; padding: 10px 0;
    }
    .cal-head-cell {
        text-align: center; padding: 10px 4px;
        background: #F8FAFC; border-bottom: 2px solid #E2E8F0;
        border-right: 1px solid #E2E8F0; font-size: 12px; font-weight: 600; color: #64748B; line-height: 1.4;
    }
    .cal-head-cell.today { background: #EFF6FF; color: #2563EB; }
    .cal-head-cell .head-day { font-size: 18px; font-weight: 700; }
    .cal-head-cell.today .head-day {
        background: #2563EB; color: #fff; border-radius: 50%;
        width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
    }
    .period-label-cell {
        display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
        padding: 14px 4px; border-right: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0; gap: 4px;
    }
    .period-icon  { font-size: 18px; }
    .period-name  { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .period-hours { font-size: 10px; color: #94A3B8; }
    .row-morning   .period-label-cell { background: #FFFBEB; }
    .row-morning   .period-name  { color: #D97706; }
    .row-afternoon .period-label-cell { background: #EFF6FF; }
    .row-afternoon .period-name  { color: #2563EB; }
    .row-evening   .period-label-cell { background: #F5F3FF; }
    .row-evening   .period-name  { color: #7C3AED; }
    .cal-cell {
        min-height: 110px; padding: 6px 5px;
        border-right: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0;
        display: flex; flex-direction: column; gap: 4px;
    }
    .row-morning   .cal-cell { background: rgba(255,251,235,0.4); }
    .row-afternoon .cal-cell { background: rgba(239,246,255,0.35); }
    .row-evening   .cal-cell { background: rgba(245,243,255,0.35); }
    .cal-cell.today-col { background: rgba(239,246,255,0.7) !important; }
    .month-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }
    .month-weekday {
        background: #F8FAFC; border-bottom: 1px solid #E2E8F0; border-right: 1px solid #E2E8F0;
        text-align: center; font-size: 12px; font-weight: 700; color: #64748B; padding: 10px 0;
    }
    .month-weekday:nth-child(7n) { border-right: none; }
    .month-cell {
        min-height: 130px; border-right: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0;
        padding: 6px; display: flex; flex-direction: column; gap: 6px; background: #fff;
    }
    .month-cell:nth-child(7n) { border-right: none; }
    .month-cell.other-month { background: #FAFAFA; }
    .month-cell.today { background: #EFF6FF; }
    .month-day {
        width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700; color: #334155;
    }
    .month-cell.other-month .month-day { color: #94A3B8; }
    .month-cell.today .month-day { background: #2563EB; color: #fff; }
    .month-events { display: flex; flex-direction: column; gap: 4px; }
    .month-ev {
        border-radius: 6px; padding: 3px 6px; color: #fff; font-size: 11px;
        line-height: 1.35; cursor: pointer; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    }
    .month-more { font-size: 10px; color: #64748B; font-weight: 600; padding-left: 3px; }
    .ev-block {
        border-radius: 7px; padding: 5px 8px; cursor: pointer;
        transition: filter 0.1s; color: #fff; overflow: hidden;
        display: flex; flex-direction: column; gap: 2px;
    }
    .ev-block:hover { filter: brightness(0.88); }
    .ev-time   { font-size: 10px; opacity: 0.85; font-weight: 500; }
    .ev-title  { font-size: 12px; font-weight: 700; line-height: 1.3;
                 overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .ev-course { font-size: 10px; opacity: 0.88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ev-zoom-badge {
        margin-top: 2px; background: rgba(255,255,255,0.22); border-radius: 3px;
        padding: 1px 5px; font-size: 10px; font-weight: 600;
        display: inline-flex; align-items: center; gap: 3px; width: fit-content;
    }

    /* ── Sidebar ────────────────────────── */
    .sidebar-box { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; }
    .sidebar-box-header {
        padding: 16px 18px; border-bottom: 1px solid #F1F5F9;
        font-size: 14px; font-weight: 700; color: #1E293B;
        display: flex; align-items: center; justify-content: space-between;
    }
    .sidebar-box-body { padding: 12px 14px; }
    .period-section-hdr {
        padding: 7px 0 5px; font-size: 10px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #F1F5F9; margin-bottom: 4px;
    }
    .period-section-hdr.morning   { color: #D97706; }
    .period-section-hdr.afternoon { color: #2563EB; }
    .period-section-hdr.evening   { color: #7C3AED; }
    .session-item {
        display: flex; gap: 10px; padding: 8px 0;
        border-bottom: 1px solid #F8FAFC; cursor: pointer; border-radius: 8px; transition: background 0.1s;
    }
    .session-item:hover { background: #F8FAFC; padding-left: 4px; }
    .session-dot { width: 4px; border-radius: 4px; flex-shrink: 0; min-height: 46px; }
    .session-info { flex: 1; }
    .session-title { font-size: 13px; font-weight: 600; color: #1E293B; margin-bottom: 2px; }
    .session-course { font-size: 11px; color: #64748B; margin-bottom: 3px; }
    .session-time { font-size: 11px; color: #94A3B8; }
    .session-day-badge {
        font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 20px;
        background: #EFF6FF; color: #2563EB;
    }
    .session-day-badge.today { background: #DCFCE7; color: #15803D; }
    .empty-sidebar { text-align: center; padding: 28px 16px; color: #94A3B8; font-size: 13px; }

    /* ── Event popup ─────────────────────── */
    .event-popup {
        display: none; position: fixed; z-index: 9999;
        background: #fff; border: 1px solid #E2E8F0; border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.14); width: 300px; overflow: hidden;
    }
    .event-popup-header {
        padding: 14px 16px; color: #fff; font-size: 14px; font-weight: 700;
        display: flex; justify-content: space-between; align-items: center;
    }
    .event-popup-body { padding: 14px 16px; }
    .event-popup-row { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 8px; font-size: 13px; color: #475569; }
    .event-popup-row i { color: #94A3B8; margin-top: 1px; flex-shrink: 0; }
    .popup-actions { padding: 10px 16px; border-top: 1px solid #F1F5F9; display: flex; gap: 8px; }
    .popup-btn {
        flex: 1; padding: 8px 0; border-radius: 7px; border: none;
        font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s;
        display: flex; align-items: center; justify-content: center; gap: 5px;
    }
    .popup-btn-edit   { background: #EFF6FF; color: #2563EB; } .popup-btn-edit:hover   { background: #DBEAFE; }
    .popup-btn-delete { background: #FEF2F2; color: #DC2626; } .popup-btn-delete:hover { background: #FEE2E2; }
    .popup-close { background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-size: 16px; padding: 0; }

    /* ── Modal ──────────────────────────── */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(15,23,42,0.4); z-index: 9990;
        align-items: center; justify-content: center;
    }
    .modal-overlay.show { display: flex; }
    .modal-card {
        background: #fff; border-radius: 16px; width: 520px; max-width: 95vw;
        box-shadow: 0 24px 60px rgba(0,0,0,0.18); overflow: hidden;
    }
    .modal-card-header {
        padding: 20px 24px; border-bottom: 1px solid #F1F5F9;
        display: flex; align-items: center; justify-content: space-between;
    }
    .modal-card-header h5 { font-weight: 700; color: #1E293B; margin: 0; font-size: 16px; }
    .modal-card-body { padding: 20px 24px; }
    .modal-card-footer { padding: 16px 24px; border-top: 1px solid #F1F5F9; display: flex; gap: 10px; justify-content: flex-end; }
    .field-group { margin-bottom: 14px; }
    .field-group label { font-size: 12px; font-weight: 600; color: #64748B; display: block; margin-bottom: 5px; }
    .field-group input, .field-group select, .field-group textarea {
        width: 100%; border: 1px solid #E2E8F0; border-radius: 8px;
        padding: 9px 12px; font-size: 13px; color: #334155; outline: none; background: #fff; font-family: inherit;
    }
    .field-group input:focus, .field-group select:focus, .field-group textarea:focus {
        border-color: #2563EB; box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
    }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .recurrence-box {
        background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;
        padding: 12px 14px; margin-top: 8px; display: none;
    }
    .recurrence-box.show { display: block; }
    .toggle-switch { display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .toggle-switch input { display: none; }
    .toggle-track {
        width: 36px; height: 20px; background: #CBD5E1; border-radius: 20px;
        position: relative; transition: background 0.2s;
    }
    .toggle-track::after {
        content: ''; position: absolute; top: 2px; left: 2px;
        width: 16px; height: 16px; background: #fff; border-radius: 50%; transition: left 0.2s;
    }
    .toggle-switch input:checked + .toggle-track { background: #2563EB; }
    .toggle-switch input:checked + .toggle-track::after { left: 18px; }
    .btn-cancel { background: #F1F5F9; color: #64748B; border: none; border-radius: 9px; padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-cancel:hover { background: #E2E8F0; }
    .btn-save { background: #2563EB; color: #fff; border: none; border-radius: 9px; padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-save:hover { background: #1D4ED8; }
    .toast-msg {
        position: fixed; bottom: 28px; right: 24px; z-index: 99999;
        padding: 12px 20px; border-radius: 10px; font-size: 13px; font-weight: 600;
        box-shadow: 0 4px 20px rgba(0,0,0,0.12); animation: toastIn 0.3s ease;
    }
    .toast-success { background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0; }
    .toast-error   { background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; }
    @@keyframes toastIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
</style>
}

<!-- Toolbar -->
<div class="cal-toolbar">
    <div class="cal-toolbar-left">
        <button class="nav-btn" id="btnPrev"><i class="bi bi-chevron-left"></i></button>
        <div class="cal-title" id="calTitle"></div>
        <button class="nav-btn" id="btnNext"><i class="bi bi-chevron-right"></i></button>
        <button class="today-btn" id="btnToday">Hôm nay</button>
    </div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <div class="view-switch" id="viewSwitch">
            <button type="button" class="view-btn" data-view="day">Ngày</button>
            <button type="button" class="view-btn active" data-view="week">Tuần</button>
            <button type="button" class="view-btn" data-view="month">Tháng</button>
        </div>
        <div id="periodLegend" style="display:flex; gap:10px;">
            <span style="font-size:12px; color:#D97706; font-weight:600;">☀ Sáng 05–12h</span>
            <span style="font-size:12px; color:#2563EB; font-weight:600;">🌤 Chiều 12–18h</span>
            <span style="font-size:12px; color:#7C3AED; font-weight:600;">🌙 Tối 18–23h</span>
        </div>
        <button class="btn-create" onclick="openCreateModal()">
            <i class="bi bi-plus-lg"></i> Tạo lịch dạy
        </button>
    </div>
</div>

<div class="cal-page">
    <!-- Calendar Grid -->
    <div class="cal-box">
        <div class="cal-grid" id="calGrid"></div>
    </div>

    <!-- Sidebar -->
    <div>
        <div class="sidebar-box">
            <div class="sidebar-box-header">
                <span><i class="bi bi-clock-history me-2"></i>Sắp tới</span>
                <span id="upcomingCount" style="font-size:12px; color:#94A3B8; font-weight:400;"></span>
            </div>
            <div class="sidebar-box-body" id="upcomingList">
                <div class="empty-sidebar"><i class="bi bi-calendar3 d-block mb-2" style="font-size:28px;"></i>Chưa có lịch dạy sắp tới</div>
            </div>
        </div>
    </div>
</div>

<!-- Event Detail Popup -->
<div class="event-popup" id="eventPopup">
    <div class="event-popup-header" id="popupHeader">
        <span id="popupTitle"></span>
        <button class="popup-close" onclick="closePopup()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="event-popup-body">
        <div class="event-popup-row"><i class="bi bi-book"></i><span id="popupCourse"></span></div>
        <div class="event-popup-row"><i class="bi bi-clock"></i><span id="popupTime"></span></div>
        <div class="event-popup-row" id="popupDescRow" style="display:none;"><i class="bi bi-card-text"></i><span id="popupDesc"></span></div>
        <div class="event-popup-row" id="popupZoomRow" style="display:none;">
            <i class="bi bi-camera-video"></i>
            <a id="popupZoomLink" href="#" target="_blank" style="color:#2563EB; font-weight:600;">Tham gia Zoom</a>
        </div>
    </div>
    <div class="popup-actions">
        <button class="popup-btn popup-btn-edit" onclick="openEditModal()"><i class="bi bi-pencil"></i> Sửa</button>
        <button class="popup-btn popup-btn-delete" onclick="deleteEvent()"><i class="bi bi-trash"></i> Xoá</button>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Create/Edit Modal -->
<div class="modal-overlay" id="scheduleModal">
    <div class="modal-card">
        <div class="modal-card-header">
            <h5 id="modalTitle"><i class="bi bi-calendar-plus me-2"></i>Tạo lịch giảng dạy</h5>
            <button class="popup-close" style="color:#94A3B8;" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <form id="scheduleForm">
            <div class="modal-card-body">
                <input type="hidden" id="editId" value="" />
                <div class="field-group">
                    <label>Khoá học <span style="color:#DC2626">*</span></label>
                    <select id="fCourse" required>
                        <option value="">-- Chọn khoá học --</option>
                        @foreach (var c in courses) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="field-group">
                    <label>Tiêu đề buổi học <span style="color:#DC2626">*</span></label>
                    <input type="text" id="fTitle" placeholder="VD: React Hooks & State Management" required />
                </div>
                <div class="field-row">
                    <div class="field-group">
                        <label>Ngày học <span style="color:#DC2626">*</span></label>
                        <input type="date" id="fDate" required />
                    </div>
                    <div></div>
                </div>
                <div class="field-row">
                    <div class="field-group">
                        <label>Giờ bắt đầu <span style="color:#DC2626">*</span></label>
                        <input type="time" id="fStart" required />
                    </div>
                    <div class="field-group">
                        <label>Giờ kết thúc <span style="color:#DC2626">*</span></label>
                        <input type="time" id="fEnd" required />
                    </div>
                </div>
                <div class="field-group">
                    <label>Link học online (Zoom / Meet)</label>
                    <input type="url" id="fZoom" placeholder="https://zoom.us/j/..." />
                </div>
                <div class="field-group">
                    <label>Nội dung buổi học</label>
                    <textarea id="fDesc" rows="2" placeholder="Mô tả ngắn nội dung..."></textarea>
                </div>
                <div id="recurrenceSection">
                    <label class="toggle-switch">
                        <input type="checkbox" id="fRecurring" onchange="toggleRecurrence(this)" />
                        <span class="toggle-track"></span>
                        <span style="font-size:13px; font-weight:600; color:#475569;">Lặp lại hàng tuần</span>
                    </label>
                    <div class="recurrence-box" id="recurrenceBox">
                        <div class="field-group" style="margin-bottom:0;">
                            <label>Số tuần lặp lại <span style="color:#DC2626">*</span></label>
                            <input type="number" id="fWeeks" min="2" max="52" value="4" style="max-width:120px;" />
                        </div>
                        <div style="font-size:12px; color:#64748B; margin-top:6px;">
                            <i class="bi bi-info-circle me-1"></i>
                            Sẽ tạo <span id="weekPreview">4</span> buổi học, mỗi tuần một buổi.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-card-footer">
                <button type="button" class="btn-cancel" onclick="closeModal()">Huỷ</button>
                <button type="submit" class="btn-save"><i class="bi bi-check-lg me-1"></i><span id="saveBtnText">Tạo lịch</span></button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const URLS = {
    getEvents:  '@Url.Action("GetEvents",  "Calendar", new { area = "Instructor" })',
    getUpcoming:'@Url.Action("GetUpcoming","Calendar", new { area = "Instructor" })',
    getById:    '@Url.Action("GetById",    "Calendar", new { area = "Instructor" })',
    create:     '@Url.Action("Create",     "Calendar", new { area = "Instructor" })',
    edit:       '@Url.Action("Edit",       "Calendar", new { area = "Instructor" })',
    del:        '@Url.Action("Delete",     "Calendar", new { area = "Instructor" })',
};
const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const VN_DAYS = ['CN', 'Th 2', 'Th 3', 'Th 4', 'Th 5', 'Th 6', 'Th 7'];
const VN_DAYS_SHORT = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];

let viewMode = 'week';
let focusDate = new Date();
let currentEventId = null, currentEventColor = '#2563EB';

function atStartOfDay(d) {
    const dt = new Date(d);
    dt.setHours(0,0,0,0);
    return dt;
}
function getWeekStart(d) {
    const dt = atStartOfDay(d);
    dt.setDate(dt.getDate() - dt.getDay());
    return dt;
}
function getMonthStart(d) {
    return new Date(d.getFullYear(), d.getMonth(), 1);
}
function dayKey(d) {
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
function getPeriod(h) {
    if (h >= 5 && h < 12)  return 'morning';
    if (h >= 12 && h < 18) return 'afternoon';
    return 'evening';
}
function fmtTime(d) { return d ? d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' }) : ''; }
function fmtDateLong(d) { return d ? d.toLocaleDateString('vi-VN', { weekday:'long', day:'2-digit', month:'2-digit', year:'numeric' }) : ''; }
function escHtml(s) { return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function getCurrentRange() {
    if (viewMode === 'day') {
        const start = atStartOfDay(focusDate);
        const end = new Date(start); end.setDate(end.getDate() + 1);
        return { start, end };
    }
    if (viewMode === 'month') {
        const start = getMonthStart(focusDate);
        const end = new Date(start.getFullYear(), start.getMonth() + 1, 1);
        return { start, end };
    }
    const start = getWeekStart(focusDate);
    const end = new Date(start); end.setDate(end.getDate() + 7);
    return { start, end };
}

function setTitle(start) {
    if (viewMode === 'day') {
        document.getElementById('calTitle').textContent =
            start.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
        return;
    }
    if (viewMode === 'month') {
        document.getElementById('calTitle').textContent = `Tháng ${start.getMonth() + 1}, ${start.getFullYear()}`;
        return;
    }
    const d0 = start, d6 = new Date(start); d6.setDate(d6.getDate() + 6);
    document.getElementById('calTitle').textContent =
        `${d0.getDate()}/${d0.getMonth()+1} – ${d6.getDate()}/${d6.getMonth()+1} tháng ${d6.getMonth()+1}, ${d6.getFullYear()}`;
}

function updateViewButtons() {
    document.querySelectorAll('#viewSwitch .view-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.view === viewMode);
    });
    document.getElementById('periodLegend').style.display = viewMode === 'month' ? 'none' : 'flex';
}

function renderPeriodGrid(start, days, events) {
    const today = atStartOfDay(new Date());
    const end = new Date(start); end.setDate(end.getDate() + days);

    const grid = Array.from({length: days}, () => ({ morning:[], afternoon:[], evening:[] }));
    for (const ev of events) {
        const startAt = new Date(ev.start);
        if (startAt < start || startAt >= end) continue;
        const dayIdx = Math.round((startAt - start) / 86400000);
        if (dayIdx < 0 || dayIdx >= days) continue;
        grid[dayIdx][getPeriod(startAt.getHours())].push(ev);
    }

    const calGrid = document.getElementById('calGrid');
    calGrid.classList.remove('month-grid');
    calGrid.style.gridTemplateColumns = `80px repeat(${days}, 1fr)`;

    let html = '';
    html += '<div class="cal-head-empty"></div>';
    for (let i = 0; i < days; i++) {
        const d = new Date(start); d.setDate(d.getDate() + i);
        const isToday = d.getTime() === today.getTime();
        html += `<div class="cal-head-cell${isToday?' today':''}">
            <div style="font-size:11px;">${VN_DAYS_SHORT[d.getDay()]}</div>
            <span class="head-day">${d.getDate()}</span>
        </div>`;
    }

    const periods = [
        { key:'morning',   cls:'row-morning',   icon:'☀', label:'Sáng', hours:'05–12h' },
        { key:'afternoon', cls:'row-afternoon', icon:'🌤', label:'Chiều', hours:'12–18h' },
        { key:'evening',   cls:'row-evening',   icon:'🌙', label:'Tối', hours:'18–23h' }
    ];
    for (const p of periods) {
        html += `<div class="${p.cls}" style="display:contents;">`;
        html += `<div class="period-label-cell">
            <span class="period-icon">${p.icon}</span>
            <span class="period-name">${p.label}</span>
            <span class="period-hours">${p.hours}</span>
        </div>`;
        for (let i = 0; i < days; i++) {
            const d = new Date(start); d.setDate(d.getDate() + i);
            const isToday = d.getTime() === today.getTime();
            html += `<div class="cal-cell${isToday?' today-col':''}">`;
            for (const ev of grid[i][p.key]) {
                const startAt = new Date(ev.start), endAt = ev.end ? new Date(ev.end) : null;
                const timeStr = endAt ? `${fmtTime(startAt)} – ${fmtTime(endAt)}` : fmtTime(startAt);
                const course  = escHtml(ev.extendedProps?.courseName ?? '');
                const zoom    = escHtml(ev.extendedProps?.zoomLink ?? '');
                const evJson  = encodeURIComponent(JSON.stringify(ev));
                html += `<div class="ev-block" style="background:${ev.color??'#2563EB'};"
                              onclick="showPopup(this, event)" data-ev="${evJson}">
                    <div class="ev-time">${timeStr}</div>
                    <div class="ev-title">${escHtml(ev.title)}</div>
                    ${course ? `<div class="ev-course">📖 ${course}</div>` : ''}
                    ${zoom   ? `<div class="ev-zoom-badge">📹 Tham gia</div>` : ''}
                </div>`;
            }
            html += '</div>';
        }
        html += '</div>';
    }
    calGrid.innerHTML = html;
}

function renderMonthGrid(monthStart, events) {
    const calGrid = document.getElementById('calGrid');
    calGrid.classList.add('month-grid');
    calGrid.style.gridTemplateColumns = 'repeat(7, 1fr)';

    const today = atStartOfDay(new Date());
    const monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 1);
    const gridStart = getWeekStart(monthStart);

    const byDay = {};
    for (const ev of events) {
        const d = new Date(ev.start);
        const key = dayKey(d);
        byDay[key] ??= [];
        byDay[key].push(ev);
    }
    Object.keys(byDay).forEach(k => byDay[k].sort((a, b) => new Date(a.start) - new Date(b.start)));

    let html = '';
    for (let i = 0; i < 7; i++) html += `<div class="month-weekday">${VN_DAYS_SHORT[i]}</div>`;

    for (let i = 0; i < 42; i++) {
        const d = new Date(gridStart); d.setDate(d.getDate() + i);
        const isToday = d.getTime() === today.getTime();
        const inMonth = d.getMonth() === monthStart.getMonth();
        const key = dayKey(d);
        const dayEvents = byDay[key] ?? [];

        html += `<div class="month-cell${isToday ? ' today' : ''}${inMonth ? '' : ' other-month'}">`;
        html += `<span class="month-day">${d.getDate()}</span>`;
        html += `<div class="month-events">`;

        dayEvents.slice(0, 3).forEach(ev => {
            const startAt = new Date(ev.start);
            const color = ev.color ?? '#2563EB';
            const evJson = encodeURIComponent(JSON.stringify(ev));
            html += `<div class="month-ev" style="background:${color};" onclick="showPopup(this, event)" data-ev="${evJson}">${fmtTime(startAt)} ${escHtml(ev.title)}</div>`;
        });

        if (dayEvents.length > 3) {
            html += `<div class="month-more">+${dayEvents.length - 3} sự kiện</div>`;
        }

        html += `</div></div>`;
        if (i >= 34 && d >= monthEnd && d.getDay() === 6) break;
    }

    calGrid.innerHTML = html;
}

async function renderCalendar() {
    const { start, end } = getCurrentRange();
    setTitle(start);
    updateViewButtons();

    let events = [];
    try {
        const r = await fetch(`${URLS.getEvents}?start=${start.toISOString()}&end=${end.toISOString()}`);
        events = await r.json();
    } catch(e) {}

    if (viewMode === 'month') {
        renderMonthGrid(start, events);
    } else if (viewMode === 'day') {
        renderPeriodGrid(start, 1, events);
    } else {
        renderPeriodGrid(start, 7, events);
    }
}

function shiftFocus(step) {
    if (viewMode === 'day') focusDate.setDate(focusDate.getDate() + step);
    else if (viewMode === 'month') focusDate.setMonth(focusDate.getMonth() + step);
    else focusDate.setDate(focusDate.getDate() + step * 7);
}

// Navigation
document.getElementById('btnPrev').onclick  = () => { shiftFocus(-1); renderCalendar(); loadUpcoming(); };
document.getElementById('btnNext').onclick  = () => { shiftFocus(1); renderCalendar(); loadUpcoming(); };
document.getElementById('btnToday').onclick = () => { focusDate = new Date(); renderCalendar(); loadUpcoming(); };
document.querySelectorAll('#viewSwitch .view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        viewMode = btn.dataset.view || 'week';
        renderCalendar();
        loadUpcoming();
    });
});

// ─── Sidebar ──────────────────────────────────────────────────────────────
function loadUpcoming() {
    fetch(URLS.getUpcoming).then(r => r.json()).then(data => {
        const el = document.getElementById('upcomingList');
        const cnt = document.getElementById('upcomingCount');
        if (!data.length) {
            el.innerHTML = '<div class="empty-sidebar"><i class="bi bi-calendar3 d-block mb-2" style="font-size:28px;"></i>Chưa có lịch dạy sắp tới</div>';
            cnt.textContent = '';
            return;
        }
        cnt.textContent = `${data.length} buổi`;

        // Group by period
        const morn = data.filter(s => { const h = parseInt(s.start); return h >= 5 && h < 12; });
        const aft  = data.filter(s => { const h = parseInt(s.start); return h >= 12 && h < 18; });
        const eve  = data.filter(s => { const h = parseInt(s.start); return h >= 18 || h < 5; });

        const renderItems = (arr) => arr.map(s => `
            <div class="session-item">
                <div class="session-dot" style="background:${s.color};"></div>
                <div class="session-info">
                    <div class="session-title">${escHtml(s.title)}</div>
                    <div class="session-course">${escHtml(s.courseName)}</div>
                    <div class="session-time">
                        <i class="bi bi-clock" style="font-size:10px;"></i>
                        ${s.start} – ${s.end}
                        &nbsp;·&nbsp;
                        <span class="session-day-badge ${s.dayLabel==='Hôm nay'?'today':''}">${s.dayLabel}</span>
                    </div>
                    ${s.zoomLink ? `<div style="margin-top:3px;"><a href="${escHtml(s.zoomLink)}" target="_blank" style="font-size:11px;color:#2563EB;font-weight:600;"><i class="bi bi-camera-video me-1"></i>Zoom</a></div>` : ''}
                </div>
            </div>`).join('');

        let html = '';
        if (morn.length) html += `<div class="period-section-hdr morning">☀ Buổi sáng</div>${renderItems(morn)}`;
        if (aft.length)  html += `<div class="period-section-hdr afternoon">🌤 Buổi chiều</div>${renderItems(aft)}`;
        if (eve.length)  html += `<div class="period-section-hdr evening">🌙 Buổi tối</div>${renderItems(eve)}`;
        el.innerHTML = html;
    });
}

// ─── Event popup ──────────────────────────────────────────────────────────
function showPopup(el, e) {
    e.stopPropagation();
    const ev = JSON.parse(decodeURIComponent(el.dataset.ev));
    const p  = ev.extendedProps ?? {};
    currentEventId    = ev.id;
    currentEventColor = ev.color ?? '#2563EB';

    const start = new Date(ev.start), end = ev.end ? new Date(ev.end) : null;
    document.getElementById('popupTitle').textContent   = ev.title;
    document.getElementById('popupHeader').style.background = currentEventColor;
    document.getElementById('popupCourse').textContent  = p.courseName ?? '';
    document.getElementById('popupTime').textContent    = end
        ? `${fmtTime(start)} – ${fmtTime(end)}, ${fmtDateLong(start)}`
        : `${fmtTime(start)}, ${fmtDateLong(start)}`;

    const dr = document.getElementById('popupDescRow');
    if (p.description) { dr.style.display='flex'; document.getElementById('popupDesc').textContent = p.description; }
    else dr.style.display = 'none';

    const zr = document.getElementById('popupZoomRow');
    if (p.zoomLink) { zr.style.display='flex'; document.getElementById('popupZoomLink').href = p.zoomLink; }
    else zr.style.display = 'none';

    const rect = el.getBoundingClientRect();
    const popup = document.getElementById('eventPopup');
    popup.style.display = 'block';
    popup.style.top  = Math.min(rect.bottom + 8, window.innerHeight - 280) + 'px';
    popup.style.left = Math.min(rect.left, window.innerWidth - 320) + 'px';
}

function closePopup() { document.getElementById('eventPopup').style.display = 'none'; }
document.addEventListener('click', (e) => {
    if (!document.getElementById('eventPopup').contains(e.target) &&
        !e.target.closest('.ev-block') &&
        !e.target.closest('.month-ev'))
        closePopup();
});

// ─── Create/Edit modal ────────────────────────────────────────────────────
function openCreateModal() {
    document.getElementById('editId').value = '';
    document.getElementById('scheduleForm').reset();
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-calendar-plus me-2"></i>Tạo lịch giảng dạy';
    document.getElementById('saveBtnText').textContent = 'Tạo lịch';
    document.getElementById('recurrenceSection').style.display = 'block';
    document.getElementById('fDate').value = new Date().toISOString().split('T')[0];
    document.getElementById('scheduleModal').classList.add('show');
}
function openEditModal() {
    closePopup();
    fetch(`${URLS.getById}?id=${currentEventId}`).then(r => r.json()).then(data => {
        document.getElementById('editId').value   = data.id;
        document.getElementById('fCourse').value  = data.courseId;
        document.getElementById('fTitle').value   = data.title;
        document.getElementById('fDate').value    = data.date;
        document.getElementById('fStart').value   = data.startTime;
        document.getElementById('fEnd').value     = data.endTime;
        document.getElementById('fZoom').value    = data.zoomLink ?? '';
        document.getElementById('fDesc').value    = data.description ?? '';
        document.getElementById('recurrenceSection').style.display = 'none';
        document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Sửa lịch giảng dạy';
        document.getElementById('saveBtnText').textContent = 'Lưu thay đổi';
        document.getElementById('scheduleModal').classList.add('show');
    });
}
function closeModal() { document.getElementById('scheduleModal').classList.remove('show'); }

// ─── Form submit ──────────────────────────────────────────────────────────
document.getElementById('scheduleForm').onsubmit = async (e) => {
    e.preventDefault();
    const isEdit = !!document.getElementById('editId').value;
    const body = new URLSearchParams();
    if (isEdit) body.append('id', document.getElementById('editId').value);
    body.append('courseId',    document.getElementById('fCourse').value);
    body.append('title',       document.getElementById('fTitle').value);
    body.append('date',        document.getElementById('fDate').value);
    body.append('startTime',   document.getElementById('fStart').value);
    body.append('endTime',     document.getElementById('fEnd').value);
    body.append('zoomLink',    document.getElementById('fZoom').value);
    body.append('description', document.getElementById('fDesc').value);
    if (!isEdit) {
        const recurring = document.getElementById('fRecurring').checked;
        body.append('recurrenceWeeks', recurring ? document.getElementById('fWeeks').value : '1');
    }
    body.append('__RequestVerificationToken', TOKEN);
    const res  = await fetch(isEdit ? URLS.edit : URLS.create, { method:'POST', body });
    const data = await res.json();
    if (data.success) {
        closeModal(); renderCalendar(); loadUpcoming();
        showToast(isEdit ? 'Đã cập nhật lịch dạy.' : `Đã tạo ${data.count} buổi học.`, 'success');
    } else showToast(data.message ?? 'Có lỗi xảy ra.', 'error');
};

// ─── Delete ───────────────────────────────────────────────────────────────
async function deleteEvent() {
    if (!confirm('Xoá buổi học này?')) return;
    closePopup();
    const body = new URLSearchParams({ id: currentEventId, __RequestVerificationToken: TOKEN });
    const res  = await fetch(URLS.del, { method:'POST', body });
    const data = await res.json();
    if (data.success) { renderCalendar(); loadUpcoming(); showToast('Đã xoá buổi học.', 'success'); }
    else showToast('Không thể xoá.', 'error');
}

// ─── Helpers ──────────────────────────────────────────────────────────────
function toggleRecurrence(cb) {
    document.getElementById('recurrenceBox').classList.toggle('show', cb.checked);
}
document.getElementById('fWeeks')?.addEventListener('input', (e) => {
    document.getElementById('weekPreview').textContent = e.target.value;
});
function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = `toast-msg toast-${type}`;
    t.innerHTML = `<i class="bi bi-${type==='success'?'check-circle':'exclamation-circle'} me-2"></i>${msg}`;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity 0.4s'; setTimeout(()=>t.remove(),400); }, 3000);
}

document.addEventListener('DOMContentLoaded', () => { renderCalendar(); loadUpcoming(); });
</script>
}
