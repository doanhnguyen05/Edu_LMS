@model StudentProgressViewModel
@{
    ViewData["Title"] = "Theo dõi Tiến độ";
    var courses = ViewBag.Courses as List<EduLMS.Web.Models.Course> ?? new List<EduLMS.Web.Models.Course>();
    var selectedCourseId = ViewBag.SelectedCourseId as int?;
    var lessonNames = ViewBag.LessonNames as List<string> ?? new List<string>();
}

<style>
    .progress-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 24px;
    }
    .progress-card h6 {
        font-size: 16px;
        font-weight: 600;
        color: #1E293B;
        margin-bottom: 16px;
    }
    .stat-box {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 24px;
    }
    .stat-box h6 {
        font-size: 16px;
        font-weight: 600;
        color: #1E293B;
        margin-bottom: 20px;
    }
    .stat-item {
        margin-bottom: 20px;
    }
    .stat-item .stat-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 14px;
    }
    .stat-item .stat-label .label-text { color: #475569; font-weight: 500; }
    .stat-item .stat-label .label-value { font-weight: 700; color: #1E293B; }
    .progress-bar-custom {
        height: 10px;
        border-radius: 5px;
        background: #F1F5F9;
        overflow: hidden;
    }
    .progress-bar-custom .fill {
        height: 100%;
        border-radius: 5px;
        transition: width 0.6s ease;
    }
    .fill-blue { background: #2563EB; }
    .fill-green { background: #16A34A; }
    .fill-red { background: #DC2626; }
    .stacked-bar {
        display: flex;
        height: 10px;
        border-radius: 5px;
        overflow: hidden;
        background: #F1F5F9;
    }
    .stacked-bar .segment {
        height: 100%;
        transition: width 0.6s ease;
    }
    .matrix-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 14px;
    }
    .matrix-table th {
        background: #F8FAFC;
        padding: 10px 14px;
        font-weight: 600;
        color: #475569;
        border-bottom: 2px solid #E2E8F0;
        text-align: center;
        white-space: nowrap;
        font-size: 12px;
    }
    .matrix-table th:first-child { text-align: left; font-size: 14px; }
    .matrix-table td {
        padding: 10px 14px;
        border-bottom: 1px solid #F1F5F9;
        text-align: center;
        vertical-align: middle;
    }
    .matrix-table td:first-child {
        text-align: left;
        font-weight: 500;
        color: #334155;
    }
    .icon-completed { color: #16A34A; font-size: 18px; }
    .icon-in-progress { color: #F59E0B; font-size: 18px; }
    .icon-not-started { color: #CBD5E1; font-size: 18px; }
    .legend {
        display: flex;
        gap: 20px;
        margin-top: 16px;
        font-size: 13px;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748B;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }
    .filter-dropdown {
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        font-size: 14px;
        padding: 6px 12px;
        color: #475569;
        min-width: 200px;
    }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-bold mb-1" style="color: #1E293B;">Theo dõi Tiến độ</h4>
        <p class="text-muted mb-0" style="font-size: 14px;">Phân tích tiến độ học tập của học viên</p>
    </div>
    <form asp-action="Index" method="get">
        <select name="courseId" class="form-select filter-dropdown" onchange="this.form.submit()">
            <option value="">-- Chọn khóa học --</option>
            @foreach (var c in courses)
            {
                <option value="@c.Id" selected="@(selectedCourseId == c.Id)">@c.Name</option>
            }
        </select>
    </form>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="progress-card">
            <h6>Phân tích điểm trung bình</h6>
            <div style="position: relative; height: 260px;">
                <canvas id="avgScoreChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="stat-box">
            <h6>Thống kê lớp học</h6>

            <div class="stat-item">
                <div class="stat-label">
                    <span class="label-text">Tỷ lệ hoàn thành</span>
                    <span class="label-value">@Model.CompletionRate%</span>
                </div>
                <div class="progress-bar-custom">
                    <div class="fill fill-blue" style="width: @Model.CompletionRate%"></div>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-label">
                    <span class="label-text">Tiến độ nộp bài</span>
                    <span class="label-value"></span>
                </div>
                <div class="d-flex justify-content-between mb-1" style="font-size: 12px;">
                    <span style="color: #16A34A; font-weight: 600;">Đúng hạn @Model.OnTimeRate%</span>
                    <span style="color: #DC2626; font-weight: 600;">Trễ hạn @(100 - Model.OnTimeRate)%</span>
                </div>
                <div class="stacked-bar">
                    <div class="segment" style="width: @Model.OnTimeRate%; background: #16A34A;"></div>
                    <div class="segment" style="width: @(100 - Model.OnTimeRate)%; background: #DC2626;"></div>
                </div>
            </div>

            <div class="stat-item mt-4">
                <div class="d-flex gap-4" style="font-size: 14px;">
                    <div class="text-center">
                        <div style="font-size: 28px; font-weight: 700; color: #1E293B;">@Model.Matrix.Count</div>
                        <div style="color: #64748B; font-size: 13px;">Học viên</div>
                    </div>
                    <div class="text-center">
                        <div style="font-size: 28px; font-weight: 700; color: #1E293B;">@lessonNames.Count</div>
                        <div style="color: #64748B; font-size: 13px;">Bài học</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Training Matrix -->
<div class="progress-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Training Matrix</h6>
        <button class="btn btn-outline-secondary btn-sm" style="border-radius: 8px; font-size: 13px;">
            <i class="bi bi-download me-1"></i> Xuất Excel
        </button>
    </div>

    @if (Model.Matrix.Any() && lessonNames.Any())
    {
        <div class="table-responsive">
            <table class="matrix-table">
                <thead>
                    <tr>
                        <th>Học viên</th>
                        @foreach (var lesson in lessonNames)
                        {
                            <th>@lesson</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Matrix)
                    {
                        <tr>
                            <td>@row.StudentName</td>
                            @foreach (var status in row.LessonStatuses)
                            {
                                <td>
                                    @if (status == "completed")
                                    {
                                        <i class="bi bi-check-circle-fill icon-completed"></i>
                                    }
                                    else if (status == "in_progress")
                                    {
                                        <i class="bi bi-clock-fill icon-in-progress"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-dash-circle icon-not-started"></i>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-table" style="font-size: 48px; color: #CBD5E1;"></i>
            <p class="mt-3 text-muted">Chọn khóa học để xem ma trận tiến độ.</p>
        </div>
    }

    <div class="legend">
        <div class="legend-item">
            <div class="legend-dot" style="background: #16A34A;"></div> Hoàn thành
        </div>
        <div class="legend-item">
            <div class="legend-dot" style="background: #F59E0B;"></div> Đang học
        </div>
        <div class="legend-item">
            <div class="legend-dot" style="background: #CBD5E1;"></div> Chưa bắt đầu
        </div>
    </div>
</div>

@section Scripts {
<script>
    const ctx = document.getElementById('avgScoreChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Json.Serialize(Model.ScoreLabels),
            datasets: [{
                label: 'Điểm TB (thang 10)',
                data: @Json.Serialize(Model.AvgScores),
                borderColor: '#2563EB',
                backgroundColor: 'rgba(37, 99, 235, 0.1)',
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#2563EB',
                pointRadius: 4
            }, {
                label: 'Điểm cao nhất',
                data: @Json.Serialize(Model.MaxScores),
                borderColor: '#16A34A',
                backgroundColor: 'rgba(22, 163, 74, 0.05)',
                fill: false,
                tension: 0.4,
                pointBackgroundColor: '#16A34A',
                pointRadius: 4,
                borderDash: [5, 5]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
            },
            scales: {
                y: { beginAtZero: true, max: 10, grid: { color: '#F1F5F9' } },
                x: { grid: { display: false } }
            }
        }
    });
</script>
}
