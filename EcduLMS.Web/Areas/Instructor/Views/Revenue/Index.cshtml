@using EduLMS.Web.Models
@using EduLMS.Web.Models.Enums
@model List<InstructorEarning>
@{
    ViewData["Title"] = "Doanh thu";
    decimal totalEarned = ViewBag.TotalEarned;
    decimal pendingAmount = ViewBag.PendingAmount;
    int pendingCount = ViewBag.PendingCount;
    int totalSales = ViewBag.TotalSales;
    decimal commissionRate = ViewBag.CommissionRate;
    var batches = ViewBag.Batches as List<PayoutBatch> ?? new();
}

<style>
    .stat-card { background: #fff; border-radius: 12px; border: 1px solid #E2E8F0; padding: 20px 24px; }
    .stat-card .label { font-size: 13px; color: #64748B; margin-bottom: 4px; }
    .stat-card .value { font-size: 24px; font-weight: 700; color: #1E293B; }
    .earning-row { padding: 14px 20px; border-bottom: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between; }
    .earning-row:last-child { border-bottom: none; }
    .badge-pending { background: #FEF9C3; color: #CA8A04; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
    .badge-paid { background: #DCFCE7; color: #16A34A; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
    .badge-draft { background: #E0E7FF; color: #4338CA; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
    .section-card { background: #fff; border-radius: 12px; border: 1px solid #E2E8F0; margin-bottom: 24px; overflow: hidden; }
    .section-card-header { padding: 16px 20px; background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-weight: 600; color: #1E293B; font-size: 15px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: #1E293B;">Doanh thu của tôi</h4>
        <p class="text-muted mb-0" style="font-size: 14px;">Hoa hồng platform: @((commissionRate * 100).ToString("N0"))% · Bạn nhận: @(((1 - commissionRate) * 100).ToString("N0"))%</p>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="label">Chờ thanh toán</div>
            <div class="value text-warning">@pendingAmount.ToString("N0")đ</div>
            <div style="font-size:12px;color:#94A3B8;margin-top:4px;">@pendingCount đơn chưa trả</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="label">Đã nhận</div>
            <div class="value text-success">@totalEarned.ToString("N0")đ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="label">Tổng đơn hàng</div>
            <div class="value">@totalSales</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="label">Thông tin ngân hàng</div>
            @if (!string.IsNullOrEmpty(ViewBag.BankAccountNumber as string))
            {
                <div class="fw-semibold" style="font-size:14px;margin-top:4px;">@ViewBag.BankName</div>
                <div style="font-size:13px;color:#64748B;">@ViewBag.BankAccountNumber</div>
            }
            else
            {
                <div class="text-muted" style="font-size:13px;margin-top:4px;">Chưa cài đặt</div>
                <div style="font-size:12px;color:#94A3B8;">Liên hệ Admin để cài đặt</div>
            }
        </div>
    </div>
</div>

<!-- Earning History -->
<div class="section-card">
    <div class="section-card-header d-flex justify-content-between">
        <span>Chi tiết thu nhập</span>
        <span class="text-muted" style="font-size:13px;font-weight:400;">@Model.Count bản ghi</span>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cash-stack" style="font-size:40px;color:#CBD5E1;"></i>
            <p class="mt-3">Chưa có doanh thu nào.</p>
        </div>
    }
    @foreach (var e in Model)
    {
        <div class="earning-row">
            <div>
                <div class="fw-semibold" style="font-size:14px;color:#1E293B;">@e.Course?.Name</div>
                <div style="font-size:12px;color:#94A3B8;">@e.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="d-flex align-items-center gap-4">
                <div class="text-end">
                    <div style="font-size:12px;color:#94A3B8;">Học viên trả</div>
                    <div style="font-size:13px;color:#64748B;">@e.GrossAmount.ToString("N0")đ</div>
                </div>
                <div class="text-end">
                    <div style="font-size:12px;color:#94A3B8;">Platform (@((e.PlatformFeeRate * 100).ToString("N0"))%)</div>
                    <div style="font-size:13px;color:#DC2626;">-@e.PlatformFee.ToString("N0")đ</div>
                </div>
                <div class="text-end" style="min-width:100px;">
                    <div style="font-size:12px;color:#94A3B8;">Bạn nhận</div>
                    <div style="font-size:15px;font-weight:700;color:#16A34A;">@e.NetAmount.ToString("N0")đ</div>
                </div>
                <div>
                    @if (e.Status == EarningStatus.Paid)
                    {
                        <span class="badge-paid"><i class="bi bi-check-circle me-1"></i>Đã thanh toán</span>
                    }
                    else
                    {
                        <span class="badge-pending"><i class="bi bi-hourglass me-1"></i>Chờ thanh toán</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Payout Batches -->
<div class="section-card">
    <div class="section-card-header">Lịch sử đợt thanh toán</div>
    @if (!batches.Any())
    {
        <div class="text-center py-4 text-muted" style="font-size:14px;">Chưa có đợt thanh toán nào.</div>
    }
    @foreach (var batch in batches)
    {
        <div class="earning-row">
            <div>
                <div class="fw-semibold" style="font-size:14px;color:#1E293B;">@batch.Note</div>
                <div style="font-size:12px;color:#94A3B8;">@batch.CreatedAt.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="fw-bold" style="font-size:16px;color:#1E293B;">@batch.TotalAmount.ToString("N0")đ</div>
                @if (batch.Status == PayoutBatchStatus.Completed)
                {
                    <span class="badge-paid"><i class="bi bi-check-circle me-1"></i>Đã nhận</span>
                }
                else
                {
                    <span class="badge-draft"><i class="bi bi-hourglass me-1"></i>Đang xử lý</span>
                }
            </div>
        </div>
    }
</div>
