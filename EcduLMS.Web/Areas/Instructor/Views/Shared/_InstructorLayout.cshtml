@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduLMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #F8FAFC; }

        .sidebar {
            width: 240px;
            background: #FFFFFF;
            border-right: 1px solid #E2E8F0;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }
        .sidebar-logo {
            padding: 20px 16px;
            font-size: 20px;
            font-weight: 700;
            color: #2563EB;
        }
        .sidebar-label {
            padding: 8px 16px;
            font-size: 11px;
            font-weight: 600;
            color: #94A3B8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0 8px;
            margin: 0;
            flex: 1;
        }
        .sidebar-menu li { margin-bottom: 2px; }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 14px;
            color: #64748B;
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.2s, color 0.2s;
        }
        .sidebar-menu a:hover {
            background: #F1F5F9;
            color: #334155;
        }
        .sidebar-menu a.active {
            background: #EFF6FF;
            color: #2563EB;
            font-weight: 600;
        }
        .sidebar-menu a i { font-size: 18px; }
        .sidebar-signout {
            padding: 16px;
            border-top: 1px solid #E2E8F0;
        }
        .sidebar-signout a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 14px;
            color: #DC2626;
            text-decoration: none;
            border-radius: 8px;
        }
        .sidebar-signout a:hover { background: #FEF2F2; }

        .topbar {
            margin-left: 240px;
            height: 64px;
            background: #FFFFFF;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .topbar-bell {
            position: relative;
            font-size: 20px;
            color: #64748B;
            cursor: pointer;
        }
        .topbar-bell .badge {
            position: absolute;
            top: -4px;
            right: -6px;
            background: #DC2626;
            color: #fff;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 10px;
        }
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .topbar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #E0E7FF;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4F46E5;
            font-weight: 600;
            font-size: 14px;
        }
        .topbar-name { font-size: 14px; font-weight: 600; color: #1E293B; }
        .topbar-role { font-size: 12px; color: #94A3B8; }
        .btn-create-course {
            background: #2563EB;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
        }
        .btn-create-course:hover { background: #1D4ED8; color: #fff; }

        .main-content {
            margin-left: 240px;
            padding: 30px;
            background: #F8FAFC;
            min-height: calc(100vh - 64px);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <i class="bi bi-mortarboard-fill"></i> EduLMS
        </div>
        <div class="sidebar-label">Main Menu</div>
        <ul class="sidebar-menu">
            <li>
                <a asp-area="Instructor" asp-controller="Dashboard" asp-action="Index"
                   class="@(currentController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Courses" asp-action="Index"
                   class="@(currentController == "Courses" ? "active" : "")">
                    <i class="bi bi-journal-bookmark"></i> My Courses
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Calendar" asp-action="Index"
                   class="@(currentController == "Calendar" ? "active" : "")">
                    <i class="bi bi-calendar3"></i> Teaching Calendar
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Grading" asp-action="Index"
                   class="@(currentController == "Grading" ? "active" : "")">
                    <i class="bi bi-award"></i> Grading Hub
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Progress" asp-action="Index"
                   class="@(currentController == "Progress" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i> Student Progress
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Revenue" asp-action="Index"
                   class="@(currentController == "Revenue" ? "active" : "")">
                    <i class="bi bi-cash-coin"></i> Doanh thu
                </a>
            </li>
            <li>
                <a asp-area="Instructor" asp-controller="Notifications" asp-action="Index"
                   class="@(currentController == "Notifications" ? "active" : "")">
                    <i class="bi bi-bell"></i> Thông báo
                </a>
            </li>
        </ul>
        <div class="sidebar-signout">
            <a asp-area="" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
        </div>
    </aside>

    <header class="topbar">
        <div class="topbar-right">
            <button type="button" class="btn btn-create-course" data-bs-toggle="modal" data-bs-target="#globalCreateCourseModal">
                <i class="bi bi-plus-lg"></i> Tạo khóa học
            </button>
            @await Component.InvokeAsync("NotificationBell")
            <div class="topbar-user dropdown">
                <a href="javascript:void(0);" class="d-flex align-items-center gap-2 text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="topbar-avatar">IN</div>
                    <div>
                        <div class="topbar-name">Instructor</div>
                        <div class="topbar-role">Instructor</div>
                    </div>
                    <i class="bi bi-chevron-down" style="font-size: 12px; color: #94A3B8;"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 10px;">
                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Global Create Course Modal -->
    <div class="modal fade" id="globalCreateCourseModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: #1E293B;">Tạo khóa học mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-area="Instructor" asp-controller="Courses" asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Tên khóa học <span class="text-danger">*</span></label>
                                <input type="text" name="Name" class="form-control" placeholder="Nhập tên khóa học" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Mã khóa học <span class="text-danger">*</span></label>
                                <input type="text" name="Code" class="form-control" placeholder="VD: CS101" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Danh mục</label>
                                <select name="CategoryId" id="globalCategorySelect" class="form-select" style="border-radius: 8px;">
                                    <option value="">Đang tải...</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Ảnh đại diện</label>
                                <input type="file" name="CoverImageFile" class="form-control" accept="image/*" style="border-radius: 8px;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Mô tả</label>
                                <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả ngắn về khóa học..." style="border-radius: 8px;"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Loại khóa học</label>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="CourseType" value="Free" id="gTypeFree" checked onchange="globalTogglePricing()">
                                        <label class="form-check-label" for="gTypeFree">Miễn phí (Free)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="CourseType" value="Paid" id="gTypePaid" onchange="globalTogglePricing()">
                                        <label class="form-check-label" for="gTypePaid">Có phí (Paid)</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" id="gPriceOriginal" style="display: none;">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Giá gốc (VNĐ)</label>
                                <input type="number" name="OriginalPrice" class="form-control" placeholder="0" min="0" style="border-radius: 8px;" />
                            </div>
                            <div class="col-md-6" id="gPricePromo" style="display: none;">
                                <label class="form-label fw-semibold" style="font-size: 14px;">Giá khuyến mãi (VNĐ)</label>
                                <input type="number" name="PromoPrice" class="form-control" placeholder="0" min="0" style="border-radius: 8px;" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy</button>
                        <button type="submit" class="btn btn-create-course" style="border-radius: 8px;">
                            <i class="bi bi-plus-lg me-1"></i> Tạo khóa học
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Load categories when modal opens
        document.getElementById('globalCreateCourseModal').addEventListener('show.bs.modal', function () {
            var sel = document.getElementById('globalCategorySelect');
            if (sel.dataset.loaded) return;
            fetch('/Instructor/Courses/GetCategories')
                .then(r => r.json())
                .then(cats => {
                    sel.innerHTML = cats.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
                    sel.dataset.loaded = '1';
                });
        });

        function globalTogglePricing() {
            var isPaid = document.getElementById('gTypePaid').checked;
            document.getElementById('gPriceOriginal').style.display = isPaid ? 'block' : 'none';
            document.getElementById('gPricePromo').style.display = isPaid ? 'block' : 'none';
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
