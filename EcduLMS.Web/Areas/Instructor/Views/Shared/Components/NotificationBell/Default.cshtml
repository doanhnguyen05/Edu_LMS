@model EduLMS.Web.ViewComponents.NotificationBellModel

<div class="topbar-bell dropdown">
    <a href="javascript:void(0);" class="text-decoration-none" data-bs-toggle="dropdown"
       aria-expanded="false" style="color:#64748B; font-size:20px; position:relative;">
        <i class="bi bi-bell"></i>
        @if (Model.UnreadCount > 0)
        {
            <span style="position:absolute;top:-4px;right:-6px;background:#DC2626;color:#fff;
                         font-size:10px;padding:2px 5px;border-radius:10px;line-height:1.2;">
                @(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount.ToString())
            </span>
        }
    </a>
    <ul class="dropdown-menu dropdown-menu-end p-0" style="width:320px; border-radius:12px; overflow:hidden;">
        <li style="padding:12px 16px; border-bottom:1px solid #F1F5F9; display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:14px; color:#1E293B;">Thông báo</span>
            @if (Model.UnreadCount > 0)
            {
                <span style="background:#EFF6FF;color:#2563EB;font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;">
                    @Model.UnreadCount chưa đọc
                </span>
            }
        </li>
        @if (!Model.Notifications.Any())
        {
            <li style="padding:32px 16px; text-align:center; color:#94A3B8;">
                <i class="bi bi-bell-slash" style="font-size:28px; display:block; margin-bottom:8px;"></i>
                <span style="font-size:13px;">Không có thông báo nào</span>
            </li>
        }
        else
        {
            @foreach (var n in Model.Notifications)
            {
                <li>
                    <a class="dropdown-item px-3 py-2" href="#"
                       style="border-bottom:1px solid #F8FAFC; white-space:normal; @(!n.IsRead ? "background:#FAFBFF;" : "")">
                        <div style="display:flex; gap:10px; align-items:flex-start;">
                            <div style="flex-shrink:0; margin-top:2px;">
                                @{
                                    var (icon, color) = n.Type switch
                                    {
                                        "assignment_submitted" => ("bi-clipboard-check", "#16A34A"),
                                        "course_approved"      => ("bi-check-circle", "#2563EB"),
                                        "instructor_announcement" => ("bi-megaphone", "#7C3AED"),
                                        "admin_broadcast_all"       => ("bi-broadcast", "#DC2626"),
                                        "admin_broadcast_learner"   => ("bi-broadcast", "#DC2626"),
                                        "admin_broadcast_instructor"=> ("bi-broadcast", "#DC2626"),
                                        "admin_broadcast_course"    => ("bi-broadcast", "#DC2626"),
                                        _ => ("bi-bell", "#64748B")
                                    };
                                }
                                <i class="bi @icon" style="font-size:15px; color:@color;"></i>
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-size:13px; color:#1E293B; font-weight:@(!n.IsRead ? "600" : "400");
                                            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @n.Title
                                </div>
                                <div style="font-size:11px; color:#94A3B8; margin-top:2px;">
                                    @n.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                </div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <div style="flex-shrink:0; width:7px; height:7px; border-radius:50%;
                                            background:#2563EB; margin-top:5px;"></div>
                            }
                        </div>
                    </a>
                </li>
            }
        }
        <li style="border-top:1px solid #F1F5F9;">
            @if (Model.Area == "Admin")
            {
                <a class="dropdown-item text-center py-2" asp-area="Admin" asp-controller="Notifications" asp-action="Index"
                   style="font-size:13px; color:#2563EB; font-weight:500;">
                    Xem tất cả thông báo →
                </a>
            }
            else
            {
                <a class="dropdown-item text-center py-2" asp-area="Instructor" asp-controller="Notifications" asp-action="Inbox"
                   style="font-size:13px; color:#2563EB; font-weight:500;">
                    Xem tất cả thông báo →
                </a>
            }
        </li>
    </ul>
</div>
