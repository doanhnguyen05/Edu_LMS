@model CourseDetailViewModel
@{
    ViewData["Title"] = Model.CourseName;
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: #64748B;
        text-decoration: none;
        margin-bottom: 20px;
    }
    .back-link:hover { color: #2563EB; }
    .course-header {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 24px;
        margin-bottom: 24px;
    }
    .course-header-top {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }
    .course-cover {
        width: 200px;
        height: 130px;
        border-radius: 10px;
        background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }
    .course-cover img { width: 100%; height: 100%; object-fit: cover; }
    .course-info h4 { font-weight: 700; color: #1E293B; margin-bottom: 8px; }
    .course-meta { font-size: 14px; color: #64748B; margin-bottom: 4px; }
    .course-meta i { margin-right: 6px; }
    .status-badge {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        margin-top: 8px;
    }
    .status-active { background: #DBEAFE; color: #2563EB; }
    .status-completed { background: #DCFCE7; color: #16A34A; }
    .status-notstarted { background: #F1F5F9; color: #64748B; }
    .progress-section {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .progress-bar-custom {
        height: 10px;
        border-radius: 5px;
        background: #E2E8F0;
        overflow: hidden;
        flex-grow: 1;
    }
    .progress-bar-fill {
        height: 100%;
        border-radius: 5px;
        background: #2563EB;
    }
    .section-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 24px;
        margin-bottom: 24px;
    }
    .section-card h5 {
        font-weight: 700;
        color: #1E293B;
        margin-bottom: 16px;
        font-size: 18px;
    }
    .lesson-list { list-style: none; padding: 0; margin: 0; }
    .lesson-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #F1F5F9;
    }
    .lesson-item:last-child { border-bottom: none; }
    .lesson-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .lesson-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .icon-completed { background: #DCFCE7; color: #16A34A; }
    .icon-inprogress { background: #DBEAFE; color: #2563EB; }
    .icon-notstarted { background: #F1F5F9; color: #94A3B8; }
    .lesson-title { font-size: 14px; color: #334155; font-weight: 500; }
    .btn-lesson {
        font-size: 13px;
        padding: 6px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        border: none;
    }
    .btn-view { background: #F1F5F9; color: #64748B; }
    .btn-view:hover { background: #E2E8F0; color: #334155; }
    .btn-resume { background: #2563EB; color: #fff; }
    .btn-resume:hover { background: #1D4ED8; color: #fff; }
    .btn-locked {
        background: #E2E8F0;
        color: #94A3B8;
        cursor: not-allowed;
        pointer-events: none;
    }
    .lesson-action {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }
    .lock-note {
        font-size: 12px;
        color: #F59E0B;
        font-weight: 500;
    }
    .assignment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #F1F5F9;
    }
    .assignment-item:last-child { border-bottom: none; }
    .assignment-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .assignment-icon {
        width: 32px; height: 32px; border-radius: 8px;
        background: #FEF3C7; color: #F59E0B;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
    }
    .assignment-title { font-size: 14px; color: #334155; font-weight: 500; }
    .btn-submit-hw {
        font-size: 13px;
        padding: 6px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        background: #F59E0B;
        color: #fff;
        border: none;
    }
    .btn-submit-hw:hover { background: #D97706; color: #fff; }
    .btn-submit-disabled {
        font-size: 13px;
        padding: 6px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        background: #E2E8F0;
        color: #94A3B8;
        border: none;
        cursor: not-allowed;
    }
    .assignment-action {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }
    .assignment-note {
        font-size: 12px;
        color: #F59E0B;
        text-align: right;
        max-width: 260px;
    }
    .btn-submitted {
        font-size: 13px;
        padding: 6px 16px;
        border-radius: 6px;
        background: #DCFCE7;
        color: #16A34A;
        font-weight: 600;
        border: none;
    }
</style>

<a asp-area="Learner" asp-controller="Training" asp-action="Index" class="back-link">
    <i class="bi bi-arrow-left"></i> Quay lại danh sách
</a>

@if (TempData["AssignmentAccessError"] != null)
{
    <div class="alert alert-warning" style="border-radius:10px;">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["AssignmentAccessError"]
    </div>
}

<div class="course-header">
    <div class="course-header-top">
        <div class="course-cover">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="@Model.CourseName" />
            }
            else
            {
                <i class="bi bi-journal-code" style="font-size: 48px; color: rgba(255,255,255,0.5);"></i>
            }
        </div>
        <div class="course-info flex-grow-1">
            <h4>@Model.CourseName</h4>
            <div class="course-meta">
                <i class="bi bi-person"></i> Giảng viên: @Model.InstructorName
            </div>
            @{
                var statusClass = Model.Status == "Hoàn thành" ? "status-completed"
                    : Model.Status == "Đang học" ? "status-active" : "status-notstarted";
            }
            <span class="status-badge @statusClass">@Model.Status</span>
            <div class="progress-section">
                <div class="progress-bar-custom">
                    <div class="progress-bar-fill" style="width: @Model.Progress%"></div>
                </div>
                <span style="font-size: 14px; font-weight: 700; color: #2563EB;">@Model.Progress%</span>
            </div>
        </div>
    </div>
</div>

<!-- Lessons -->
<div class="section-card">
    <h5><i class="bi bi-journal-text me-2"></i>Nội dung khóa học</h5>
    <ul class="lesson-list">
        @foreach (var lesson in Model.Lessons)
        {
            var iconClass = lesson.Status == "completed" ? "icon-completed"
                : lesson.Status == "in_progress" ? "icon-inprogress" : "icon-notstarted";
            var iconName = lesson.Status == "completed" ? "bi-check-lg"
                : lesson.Status == "in_progress" ? "bi-clock" : "bi-circle";
            var btnClass = lesson.Status == "in_progress" ? "btn-resume" : "btn-view";
            var btnText = lesson.Status == "completed" ? "Xem lại bài"
                : lesson.Status == "in_progress" ? "Tiếp tục học"
                : "Bắt đầu học";

            <li class="lesson-item">
                <div class="lesson-left">
                    <div class="lesson-icon @iconClass">
                        <i class="bi @iconName"></i>
                    </div>
                    <span class="lesson-title">@lesson.Title</span>
                </div>
                <div class="lesson-action">
                    @if (lesson.IsLocked)
                    {
                        <span class="btn-lesson btn-locked">Bị khóa</span>
                        <span class="lock-note">@lesson.LockMessage</span>
                    }
                    else
                    {
                        <a asp-area="Learner" asp-controller="Lesson" asp-action="View" asp-route-id="@lesson.Id" class="btn-lesson @btnClass">
                            @btnText
                        </a>
                    }
                </div>
            </li>
        }
    </ul>
</div>

<!-- Assignments -->
<div class="section-card">
    <h5><i class="bi bi-pencil-square me-2"></i>Bài tập & Đánh giá</h5>
    @foreach (var assignment in Model.Assignments)
    {
        <div class="assignment-item">
            <div class="assignment-left">
                <div class="assignment-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <span class="assignment-title">@assignment.Title</span>
            </div>
            @if (assignment.IsSubmitted)
            {
                <span class="btn-submitted">
                    <i class="bi bi-check-circle me-1"></i> Đã nộp
                </span>
            }
            else if (assignment.CanStart)
            {
                <a asp-area="Learner" asp-controller="Assignment" asp-action="Submit" asp-route-id="@assignment.Id" class="btn-submit-hw">
                    Làm bài ngay
                </a>
            }
            else
            {
                <div class="assignment-action">
                    <span class="btn-submit-disabled">Chưa mở</span>
                    <span class="assignment-note">@assignment.BlockedReason</span>
                </div>
            }
        </div>
    }
</div>
