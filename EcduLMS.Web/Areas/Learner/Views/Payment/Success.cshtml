@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div style="max-width: 500px; margin: 60px auto; text-align: center;">
    <div style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 48px 32px;">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: #DCFCE7; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
            <i class="bi bi-check-circle-fill" style="font-size: 40px; color: #16A34A;"></i>
        </div>
        <h4 style="font-weight: 700; color: #1E293B; margin-bottom: 8px;">Thanh toán thành công!</h4>
        <p style="color: #64748B; font-size: 14px; margin-bottom: 24px;">
            Bạn đã đăng ký thành công khóa học <strong>@ViewBag.CourseName</strong>.
            Bắt đầu học ngay nào!
        </p>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <a asp-area="Learner" asp-controller="Training" asp-action="Detail" asp-route-id="@ViewBag.CourseId"
               class="btn btn-primary px-4" style="border-radius: 8px; background: #2563EB; border-color: #2563EB;">
                <i class="bi bi-play-circle me-1"></i> Bắt đầu học
            </a>
            <a asp-area="Learner" asp-controller="Training" asp-action="Index"
               class="btn btn-outline-secondary px-4" style="border-radius: 8px;">
                <i class="bi bi-journal-bookmark me-1"></i> My Training
            </a>
        </div>
    </div>
</div>
